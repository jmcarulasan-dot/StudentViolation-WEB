@page "/"
@page "/login"
@inject NavigationManager Nav
@inject AuthService AuthService
@inject HttpClient Http
@inject ISnackbar Snackbar

<div style="display:flex; height:100vh; width:100%; font-family:'Segoe UI',system-ui,sans-serif; background:linear-gradient(135deg,#0e1017 0%, #151821 100%); color:#f2f4f8;">

    @* ── Left: brand + form ── *@
    <div style="flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:60px 32px; overflow-y:auto;">
        <div style="display:flex; flex-direction:column; align-items:center; text-align:center; margin-bottom:28px;">
            <img src="Image/aclc_logo.png" alt="ACLC Logo" style="width:70px; height:84px; border-radius:22px; margin-bottom:18px;" />
            <MudText Typo="Typo.h3" Style="color:#f2f4f8; font-weight:700; letter-spacing:0.2px; margin:0 0 8px;">Student Violation System</MudText>
            <MudText Typo="Typo.body2" Style="color:#8e93a3; margin:0;">ACLC College of Mandaue</MudText>
        </div>

        <MudPaper Elevation="8" Style="width:100%; max-width:440px; background:#151821; border:1px solid rgba(255,255,255,0.09); border-radius:20px; padding:36px 32px; box-shadow:0 20px 60px rgba(0,0,0,0.45);">
            <MudText Typo="Typo.h4" Style="color:#f2f4f8; font-weight:700; margin:0 0 4px;">Welcome back</MudText>
            <MudText Typo="Typo.body2" Style="color:#8e93a3; margin:0 0 26px;">Sign in to your account to continue</MudText>

            <MudForm @ref="form" @bind-IsValid="isValid">

                <div style="margin-bottom:16px;">
                    <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Username</MudText>
                    <MudTextField T="string"
                                  @bind-Value="username"
                                  Required="true"
                                  RequiredError="Username is required"
                                  Placeholder="Enter your username"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Person"
                                  FullWidth="true"
                                  Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                </div>

                <div style="margin-bottom:16px;">
                    <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Password</MudText>
                    <MudTextField T="string"
                                  @bind-Value="password"
                                  Required="true"
                                  RequiredError="Password is required"
                                  Placeholder="Enter your password"
                                  InputType="@pwdType"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@pwdIcon"
                                  OnAdornmentClick="TogglePassword"
                                  FullWidth="true"
                                  Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                </div>

                @if (showRecoveryCodes)
                {
                    <MudAlert Severity="Severity.Success"
                              Style="background:rgba(166,232,216,0.08); color:#f2f4f8; border:1px solid rgba(166,232,216,0.25); border-radius:12px; margin-bottom:16px;">
                        Save these recovery codes now. Each can be used once.
                        <MudText Typo="Typo.body2">@string.Join("    ", loginFlow?.RecoveryCodes ?? new List<string>())</MudText>
                    </MudAlert>
                }
                else if (loginFlow?.ChallengeId is not null)
                {
                    @if (loginFlow.RequiresAuthenticatorSetup && !string.IsNullOrWhiteSpace(loginFlow.QrCodeDataUri))
                    {
                        <MudAlert Severity="Severity.Info"
                                  Style="background:rgba(166,232,216,0.08); color:#f2f4f8; border:1px solid rgba(166,232,216,0.25); border-radius:12px; margin-bottom:16px;">
                            Scan this code with your authenticator app.
                            <img src="@loginFlow.QrCodeDataUri" alt="Authenticator setup QR code"
                                 style="display:block;width:190px;height:190px;margin:12px auto;background:white;padding:8px" />
                            @if (!string.IsNullOrWhiteSpace(loginFlow.ManualEntryKey))
                            {
                                <div style="margin-top:8px;">Manual setup key: <b>@loginFlow.ManualEntryKey</b></div>
                            }
                        </MudAlert>
                    }
                    <div style="margin-bottom:16px;">
                        <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Authenticator or recovery code</MudText>
                        <MudTextField T="string"
                                      @bind-Value="authCode"
                                      Placeholder="Enter your code"
                                      Required="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true"
                                      Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                    </div>
                }

                <div style="display:flex; justify-content:space-between; align-items:center; margin:4px 0 22px;">
                    <MudCheckBox T="bool"
                                 Label="Remember me"
                                 @bind-Checked="rememberMe"
                                 Color="Color.Inherit"
                                 Style="color:#f2f4f8; margin-left:-8px;" />
                    <MudLink Href="#"
                             Style="color:#a6e8d8; font-weight:600; font-size:0.88rem; cursor:pointer;">Forgot password?</MudLink>
                </div>

                @if (isLoading)
                {
                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Size="Size.Large"
                               Disabled="true"
                               Style="background:#7fd6c2; color:#0e1017; font-weight:700; font-size:0.98rem; border-radius:10px; padding:13px 16px; text-transform:none; box-shadow:0 8px 24px rgba(166,232,216,0.22);">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="margin-right:8px;" />
                        Signing In...
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Size="Size.Large"
                               Disabled="!isValid"
                               OnClick="HandleContinue"
                               Style="background:linear-gradient(90deg,#a6e8d8,#7fd6c2); color:#0e1017; font-weight:700; font-size:0.98rem; border-radius:10px; padding:13px 16px; text-transform:none; box-shadow:0 8px 24px rgba(166,232,216,0.22);">
                        @(showRecoveryCodes ? "Continue" : loginFlow?.ChallengeId is not null ? "Verify code" : "Sign In")
                    </MudButton>
                }

            </MudForm>

            <p style="text-align:center; font-size:0.9rem; color:#8e93a3; margin:24px 0 0; padding-top:20px; border-top:1px solid rgba(255,255,255,0.09);">
                Don't have an account?
                <MudLink Href="/register"
                         Style="color:#a6e8d8; font-weight:700; margin-left:4px; text-decoration:none;">Create account</MudLink>
            </p>
        </MudPaper>
    </div>

    @* ── Right: hero panel ── *@
    <div style="flex:1; display:flex; flex-direction:column; justify-content:center; padding:56px; overflow:hidden;
                background:linear-gradient(180deg,rgba(14,16,23,0.55) 0%,rgba(14,16,23,0.82) 100%),
                           radial-gradient(circle at 70% 20%,#1d3b3a 0%,#0e1017 65%);
                border-left:1px solid rgba(255,255,255,0.09);">

        <div style="position:absolute; top:48px; left:56px; display:inline-flex; align-items:center; gap:8px;
                    padding:8px 16px; border-radius:999px; font-size:0.85rem; color:#f2f4f8;
                    background:rgba(21,24,33,0.7); border:1px solid rgba(255,255,255,0.18); backdrop-filter:blur(8px);">
            <MudIcon Icon="@Icons.Material.Filled.Bolt" Style="color:#a6e8d8; font-size:1.1rem;" />
            <span>Student Affairs Office</span>
        </div>

        <MudText Typo="Typo.h3"
                 Style="color:#f2f4f8; font-weight:700; line-height:1.12; margin:0 0 18px;">
            Keep student records
            <span style="color:#a6e8d8; display:block;">clear and fair.</span>
        </MudText>
        <MudText Typo="Typo.body1"
                 Style="color:rgba(242,244,248,0.82); line-height:1.6; margin:0 0 32px; max-width:460px;">
            Review violations, appeals, and student cases in one place at ACLC College of Mandaue.
        </MudText>

        <div style="display:flex; align-items:center; gap:16px; max-width:440px; padding:16px 18px; margin-bottom:14px;
                    border-radius:14px; background:rgba(21,24,33,0.62); border:1px solid rgba(255,255,255,0.09); backdrop-filter:blur(10px);">
            <div style="width:44px; height:44px; border-radius:12px; display:grid; place-items:center;
                        background:rgba(166,232,216,0.14); color:#a6e8d8; flex-shrink:0;">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
            </div>
            <div>
                <b style="color:#f2f4f8;">Violation records</b>
                <div style="color:#8e93a3; font-size:0.85rem;">Log and review every case</div>
            </div>
        </div>
        <div style="display:flex; align-items:center; gap:16px; max-width:440px; padding:16px 18px; margin-bottom:14px;
                    border-radius:14px; background:rgba(21,24,33,0.62); border:1px solid rgba(255,255,255,0.09); backdrop-filter:blur(10px);">
            <div style="width:44px; height:44px; border-radius:12px; display:grid; place-items:center;
                        background:rgba(166,232,216,0.14); color:#a6e8d8; flex-shrink:0;">
                <MudIcon Icon="@Icons.Material.Filled.Shield" />
            </div>
            <div>
                <b style="color:#f2f4f8;">Secure access</b>
                <div style="color:#8e93a3; font-size:0.85rem;">Sign-in protected by an authenticator code</div>
            </div>
        </div>
    </div>
</div>

@code {
    MudForm form = default!;
    bool isValid;
    bool isLoading;
    bool rememberMe;
    bool showRecoveryCodes;
    public string username = "";
    public string password = "";
    string authCode = "";
    LoginFlow? loginFlow;

    InputType pwdType = InputType.Password;
    string pwdIcon = Icons.Material.Filled.VisibilityOff;

    void TogglePassword()
    {
        if (pwdType == InputType.Password)
        {
            pwdType = InputType.Text;
            pwdIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            pwdType = InputType.Password;
            pwdIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    async Task HandleContinue()
    {
        if (showRecoveryCodes)
        {
            NavigateByRole(loginFlow?.Role);
            return;
        }
        if (loginFlow?.ChallengeId is not null)
        {
            await VerifyMfa();
            return;
        }
        await HandleLogin();
    }

    async Task HandleLogin()
    {
        await form.Validate();
        if (!isValid) return;
        isLoading = true;
        try
        {
            var result = await AuthService.LoginAsync(new LoginModel
            {
                Username = username.Trim().ToLowerInvariant(),
                Password = password
            });
            if (result.Status == 200 && result.Data?.ChallengeId is not null)
            {
                loginFlow = result.Data;
                authCode = "";
            }
            else
            {
                Snackbar.Add(result.Message ?? "Sign-in could not start.", Severity.Error);
            }
        }
        finally { isLoading = false; }
    }

    async Task VerifyMfa()
    {
        if (string.IsNullOrWhiteSpace(authCode) || loginFlow?.ChallengeId is null)
        {
            Snackbar.Add("Enter the current authenticator or recovery code.", Severity.Warning);
            return;
        }
        isLoading = true;
        try
        {
            var result = await AuthService.VerifyAuthenticatorAsync(new AuthenticatorVerifyRequest
            {
                ChallengeId = loginFlow.ChallengeId,
                Code = authCode.Trim()
            });
            if (result.Status == 200 && !string.IsNullOrWhiteSpace(result.Data?.Token))
            {
                loginFlow = result.Data;
                await AuthService.SaveAccountUsernameAsync(username.Trim().ToLowerInvariant());
                if (result.Data.RecoveryCodes?.Count > 0) showRecoveryCodes = true;
                else NavigateByRole(result.Data.Role);
            }
            else
            {
                if (result.Status == 423 ||
                    result.Message?.Contains("Sign in again", StringComparison.OrdinalIgnoreCase) == true)
                {
                    loginFlow = null;
                    authCode = "";
                }
                Snackbar.Add(result.Message ?? "Authenticator verification failed.", Severity.Error);
            }
        }
        finally { isLoading = false; }
    }

    void NavigateByRole(string? role)
    {
        switch (role)
        {
            case "Student": Nav.NavigateTo("/student/dashboard"); break;
            case "Guard": Nav.NavigateTo("/guard/dashboard"); break;
            case "SAO": Nav.NavigateTo("/sao/dashboard"); break;
            case "Admission": Nav.NavigateTo("/admission/dashboard"); break;
            default: Snackbar.Add("This account does not have a web dashboard.", Severity.Warning); break;
        }
    }
}
