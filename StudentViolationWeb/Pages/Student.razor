@page "/student"
@inject NavigationManager Nav
@inject HttpClient Http
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject StudentService StudentService

<PageTitle>Student Dashboard</PageTitle>

<MudLayout>

    @* ── Top Bar ── *@
    <MudAppBar Elevation="0"
               Style="background:rgba(255,255,255,0.95);
                      backdrop-filter:blur(20px);
                      border-bottom:1px solid #E1F5FE;">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       OnClick="GoBack"
                       Style="color:#546E7A;" />
        <MudSpacer />
        <MudText Typo="Typo.h6"
                 Style="font-weight:700; color:#0288D1; letter-spacing:0.02em;">
            Student Dashboard
        </MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                   OnClick="Logout"
                   Style="color:#546E7A;" />
        
    </MudAppBar>

    @* ── Main Content ── *@
    <MudMainContent Style="background:#F4F9FD; min-height:100vh; padding-bottom:80px;">

        <div style="position:fixed; inset:0;
                    background:
                        radial-gradient(ellipse 60% 50% at 0% 0%,  #E1F5FE 0%, transparent 60%),
                        radial-gradient(ellipse 40% 40% at 100% 100%, #B3E5FC 0%, transparent 60%);
                    pointer-events:none; z-index:0;"></div>

        <div style="position:fixed; inset:0;
                    background-image:radial-gradient(#B3E5FC 1px, transparent 1px);
                    background-size:24px 24px;
                    pointer-events:none; z-index:0; opacity:0.45;"></div>

        <div style="position:relative; z-index:1; padding:16px 16px 0;">

            @* ══════════ TAB 0 — DASHBOARD ══════════ *@
            @if (_activeTab == 0)
            {
                @* Welcome Banner *@
                <div style="background:linear-gradient(135deg,#FFFFFF,#E1F5FE);
                                border:1px solid #B3E5FC; border-radius:16px;
                                padding:16px 20px; margin-bottom:18px;
                                display:flex; align-items:center; gap:16px;
                                box-shadow:0 4px 12px rgba(2,136,209,0.08);">
                    <div style="width:44px; height:44px; border-radius:12px;
                                    background:#0288D1;
                                    display:flex; align-items:center; justify-content:center;
                                    flex-shrink:0;
                                    box-shadow:0 4px 8px rgba(2,136,209,0.25);">
                        <img src="Image/aclc_logo(1).png"
                             alt="ACLC Logo"
                             style="width: 30px; height: auto;" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle1"
                                 Style="font-weight:700; color:#0288D1; font-size:14px;">
                            Welcome, @(_dashboard?.name ?? "Student")!
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#546E7A; font-size:11px;">
                            Student Portal — view your violations and QR code
                        </MudText>
                    </div>
                </div>

                @* Stats Row *@
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
                    <div style="width:4px; height:20px; background:#0288D1; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Style="color:#0288D1; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        Overview
                    </MudText>
                </div>

                <div style="display:flex; gap:8px; margin-bottom:14px;">
                    @foreach (var stat in new[]
                                    {
                                ((_dashboard?.total_violations ?? 0).ToString(), "Total",    "#1A237E", "#C5CAE9"),
                                ((_dashboard?.pending ?? 0).ToString(),          "Pending",  "#F9A825", "#FFE082"),
                                ((_dashboard?.approved ?? 0).ToString(),         "Approved", "#2E7D32", "#A5D6A7"),
                                ((_dashboard?.rejected ?? 0).ToString(),         "Rejected", "#E53935", "#FFCDD2")
                                })
                    {
                        <div style="flex:1; background:#FFFFFF;
                                            border:1px solid @stat.Item4;
                                            border-radius:12px; padding:10px 8px;
                                            text-align:center;
                                            box-shadow:0 2px 6px rgba(2,136,209,0.06);">
                            <MudText Style="@($"font-size:1.4rem; font-weight:700; color:{stat.Item3}; line-height:1.1;")">
                                @stat.Item1
                            </MudText>
                            <MudText Style="font-size:0.68rem; color:#90A4AE; margin-top:2px; font-weight:600;
                                                   text-transform:uppercase; letter-spacing:0.04em;">
                                @stat.Item2
                            </MudText>
                        </div>
                    }
                </div>

                @* Warning Level *@
                <div style="background:#FFFFFF; border:1px solid @GetWarningBorderColor();
                                border-radius:12px; padding:12px 16px; margin-bottom:14px;
                                display:flex; align-items:center; gap:10px;
                                box-shadow:0 2px 8px rgba(2,136,209,0.05);">
                    <MudIcon Icon="@GetWarningIcon()"
                             Style="@($"color:{GetWarningColor()}; font-size:22px;")" />
                    <div>
                        <MudText Style="@($"color:{GetWarningColor()}; font-weight:700; font-size:12px;")">
                            Warning Level: @(_dashboard?.warning_level?.ToUpper() ?? "GREEN")
                        </MudText>
                        <MudText Style="color:#546E7A; font-size:11px;">
                            @GetWarningMessage()
                        </MudText>
                    </div>
                </div>

                @* Recommended Action *@
                @if (!string.IsNullOrEmpty(_dashboard?.recommended_action) &&
                            _dashboard.recommended_action != "No action needed")
                {
                    <div style="background:#FFF8E1; border:1px solid #FFE082;
                                        border-radius:12px; padding:10px 16px; margin-bottom:14px;
                                        display:flex; align-items:center; gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Style="color:#F9A825; font-size:18px;" />
                        <MudText Style="font-size:12px; color:#795548; font-weight:500;">
                            @_dashboard!.recommended_action
                        </MudText>
                    </div>
                }

                @* Violation History *@
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
                    <div style="width:4px; height:20px; background:#F9A825; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.History" Style="color:#F9A825; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        Violation History
                    </MudText>
                </div>

                <div style="background:#FFFFFF; border:1px solid #E1F5FE;
                                border-radius:16px; overflow:hidden;
                                box-shadow:0 2px 10px rgba(2,136,209,0.06); margin-bottom:16px;">

                    @if (_isLoading)
                    {
                        <div style="padding:32px; text-align:center;">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                        </div>
                    }
                    else if (_dashboard?.violations?.Any() == true)
                    {
                        @foreach (var v in _dashboard.violations)
                        {
                            <div style="padding:14px 18px; border-bottom:1px solid #F0F7FF;">
                                <div style="display:flex; align-items:center; gap:14px; margin-bottom:6px;">
                                    <div style="width:38px; height:38px; border-radius:50%;
                                                            background:linear-gradient(135deg,#E1F5FE,#B3E5FC);
                                                            border:1px solid #81D4FA;
                                                            display:flex; align-items:center; justify-content:center;
                                                            flex-shrink:0;">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning"
                                                 Style="color:#0288D1; font-size:18px;" />
                                    </div>
                                    <div style="flex:1; min-width:0;">
                                        <MudText Style="font-size:13px; font-weight:600; color:#1A237E;
                                                                   white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                            @v.type
                                        </MudText>
                                        <MudText Style="font-size:11px; color:#90A4AE; margin-top:1px;">
                                            @v.date.ToString("MMM dd, yyyy")  ·  Recorded by: @v.recorded_by
                                        </MudText>
                                    </div>
                                    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:4px;">
                                        <span style="@SeverityBadge(v.severity)">@v.severity?.ToUpper()</span>
                                        <span style="@StatusBadge(v.status)">@v.status</span>
                                    </div>
                                </div>

                                @* Details *@
                                @if (!string.IsNullOrEmpty(v.details))
                                {
                                    <MudText Style="font-size:11px; color:#546E7A; margin-left:52px; margin-bottom:4px;">
                                        @v.details
                                    </MudText>
                                }

                                @* Appeal Section *@
                                <div style="margin-left:52px; margin-top:6px;">
                                    @if (v.appeal_status == "Pending")
                                    {
                                        <span style="font-size:10px; color:#F9A825; font-weight:600;">
                                            ⏳ Appeal pending review
                                        </span>
                                    }
                                    else if (v.appeal_status == "Approved")
                                    {
                                        <span style="font-size:10px; color:#2E7D32; font-weight:600;">
                                            ✅ Appeal approved — @v.appeal_remarks
                                        </span>
                                    }
                                    else if (v.appeal_status == "Rejected")
                                    {
                                        <span style="font-size:10px; color:#E53935; font-weight:600;">
                                            ❌ Appeal rejected — @v.appeal_remarks
                                        </span>
                                    }
                                    else if (v.appeal_status == "None" || string.IsNullOrEmpty(v.appeal_status))
                                    {
                                        <MudButton Variant="Variant.Outlined"
                                                   Size="Size.Small"
                                                   OnClick="() => OpenAppealDialog(v)"
                                                   Style="font-size:10px; height:24px; border-color:#0288D1; color:#0288D1; text-transform:none;">
                                            Submit Appeal
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding:40px; text-align:center;">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline"
                                     Style="color:#CFD8DC; font-size:48px;" />
                            <MudText Typo="Typo.caption" Style="display:block; color:#90A4AE; margin-top:8px;">
                                No violations recorded — keep it up! 🎉
                            </MudText>
                        </div>
                    }
                </div>
            }

            @* ══════════ TAB 1 — PROFILE ══════════ *@
            @if (_activeTab == 1)
            {
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
                    <div style="width:4px; height:20px; background:#0288D1; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.Person" Style="color:#0288D1; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        My Profile
                    </MudText>
                </div>

                @if (_isLoading)
                {
                    <div style="text-align:center; padding:32px;">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else
                {
                    @* Avatar Card *@
                    <div style="background:linear-gradient(135deg,#FFFFFF,#E1F5FE);
                                        border:1px solid #B3E5FC; border-radius:16px;
                                        padding:20px; margin-bottom:14px;
                                        display:flex; flex-direction:column; align-items:center;
                                        box-shadow:0 4px 12px rgba(2,136,209,0.08);">
                        <div style="width:64px; height:64px; border-radius:50%;
                                            background:#0288D1;
                                            display:flex; align-items:center; justify-content:center;
                                            font-size:22px; font-weight:700; color:#FFFFFF;
                                            box-shadow:0 4px 12px rgba(2,136,209,0.30);
                                            margin-bottom:10px;">
                            @(_profile?.name?.Substring(0, 1).ToUpper() ?? "S")
                        </div>
                        <MudText Style="font-weight:700; font-size:15px; color:#1A237E;">
                            @(_profile?.name ?? "—")
                        </MudText>
                        <MudText Style="font-size:11px; color:#546E7A; margin-top:2px;">
                            @(_profile?.student_no ?? "—")
                        </MudText>

                        @* Status Badge *@
                        @if (!string.IsNullOrEmpty(_profile?.status))
                        {
                            <span style="@AccountStatusBadge(_profile.status); margin-top:8px;">
                                @_profile.status
                            </span>
                        }
                    </div>

                    @* Info Card *@
                    <div style="background:#FFFFFF; border:1px solid #E1F5FE;
                                        border-radius:16px; overflow:hidden;
                                        box-shadow:0 2px 10px rgba(2,136,209,0.06);">

                        @foreach (var row in new[]
                                        {
                                ("Course",  _profile?.course ?? "—",           Icons.Material.Filled.School),
                                ("Year",    _profile?.year ?? "—",             Icons.Material.Filled.CalendarToday),
                                ("Email",   _profile?.email ?? "—",            Icons.Material.Filled.Email),
                                ("Gender",  _profile?.gender ?? "—",           Icons.Material.Filled.Person),
                                ("Contact", _profile?.contact_number ?? "—",   Icons.Material.Filled.Phone),
                                ("Address", _profile?.address ?? "—",          Icons.Material.Filled.LocationOn),
                                })
                        {
                            <div style="display:flex; align-items:flex-start; gap:14px;
                                                    padding:13px 18px; border-bottom:1px solid #F0F7FF;">
                                <MudIcon Icon="@row.Item3"
                                         Style="color:#90A4AE; font-size:18px; flex-shrink:0; margin-top:1px;" />
                                <MudText Style="font-size:11px; font-weight:600; color:#90A4AE;
                                                           text-transform:uppercase; letter-spacing:0.06em;
                                                           width:56px; flex-shrink:0; margin-top:1px;">
                                    @row.Item1
                                </MudText>
                                <MudText Style="font-size:13px; color:#1A237E; font-weight:500;
                                                           flex:1; word-break:break-word;">
                                    @row.Item2
                                </MudText>
                            </div>
                        }
                    </div>
                }
            }

            @* ══════════ TAB 2 — QR CODE ══════════ *@
            @if (_activeTab == 2)
            {
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
                    <div style="width:4px; height:20px; background:#0288D1; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.QrCode2" Style="color:#0288D1; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        My QR Code
                    </MudText>
                </div>

                <div style="background:#FFFFFF; border:1px solid #E1F5FE;
                                border-radius:16px; padding:24px 20px; text-align:center;
                                box-shadow:0 2px 10px rgba(2,136,209,0.06);">

                    <MudText Typo="Typo.caption"
                             Style="color:#546E7A; font-size:11px; margin-bottom:16px; display:block;">
                        Show this to the Guard for scanning
                    </MudText>

                    <div style="width:210px; height:210px;
                                    background:#0D1233; border-radius:12px;
                                    margin:0 auto 16px;
                                    display:flex; align-items:center; justify-content:center;
                                    position:relative; overflow:hidden;">

                        @* Corner guides *@
                        <div style="position:absolute; top:11px; left:11px; width:20px; height:20px;
                                        border-top:2px solid rgba(255,255,255,0.7);
                                        border-left:2px solid rgba(255,255,255,0.7);"></div>
                        <div style="position:absolute; top:11px; right:11px; width:20px; height:20px;
                                        border-top:2px solid rgba(255,255,255,0.7);
                                        border-right:2px solid rgba(255,255,255,0.7);"></div>
                        <div style="position:absolute; bottom:11px; left:11px; width:20px; height:20px;
                                        border-bottom:2px solid rgba(255,255,255,0.7);
                                        border-left:2px solid rgba(255,255,255,0.7);"></div>
                        <div style="position:absolute; bottom:11px; right:11px; width:20px; height:20px;
                                        border-bottom:2px solid rgba(255,255,255,0.7);
                                        border-right:2px solid rgba(255,255,255,0.7);"></div>

                        @if (_isLoading)
                        {
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        }
                        else if (!string.IsNullOrEmpty(_qr?.qr_code))
                        {
                            @* IMPORTANT: API returns raw base64 — must add the data URI prefix *@
                            <img src="data:image/png;base64,@_qr.qr_code"
                                 style="width:182px; height:182px; object-fit:contain;"
                                 alt="QR Code" />
                        }
                        else
                        {
                            <div style="text-align:center;">
                                <MudIcon Icon="@Icons.Material.Filled.QrCode2"
                                         Style="font-size:80px; color:rgba(255,255,255,0.30);" />
                                <MudText Typo="Typo.caption"
                                         Style="display:block; margin-top:6px;
                                                        color:rgba(255,255,255,0.45); font-size:11px;">
                                    QR not available
                                </MudText>
                            </div>
                        }
                    </div>

                    <MudText Style="font-weight:700; color:#1A237E; font-size:14px;">
                        @(_qr?.student_no ?? "—")
                    </MudText>
                    <MudText Style="color:#546E7A; font-size:12px; margin-top:2px;">
                        @(_qr?.name ?? "—")
                    </MudText>
                </div>
            }

        </div>
    </MudMainContent>

    @* ── Bottom Nav ── *@
    <div style="position:fixed; bottom:0; left:0; right:0; z-index:300;
                background:rgba(255,255,255,0.97); backdrop-filter:blur(24px);
                border-top:1px solid #E1F5FE;
                box-shadow:0 -4px 20px rgba(26,35,126,0.08);
                height:68px; display:flex; align-items:center; padding:0 8px;">

        <button @onclick="() => SetTab(0)" style="@NavBtn(0)">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Style="@NavIcon(0)" />
            <span style="@NavLabel(0)">Dashboard</span>
        </button>
        <button @onclick="() => SetTab(1)" style="@NavBtn(1)">
            <MudIcon Icon="@Icons.Material.Filled.Person" Style="@NavIcon(1)" />
            <span style="@NavLabel(1)">Profile</span>
        </button>
        <button @onclick="() => SetTab(2)" style="@NavBtn(2)">
            <MudIcon Icon="@Icons.Material.Filled.QrCode2" Style="@NavIcon(2)" />
            <span style="@NavLabel(2)">QR Code</span>
        </button>

    </div>

</MudLayout>

@* ══════════ APPEAL DIALOG ══════════ *@
@if (_showAppealDialog && _selectedViolation != null)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.5);
                    z-index:1000; display:flex; align-items:center; justify-content:center;
                    padding:16px;">
        <div style="background:#FFFFFF; border-radius:20px; padding:24px;
                        width:100%; max-width:420px;
                        box-shadow:0 20px 60px rgba(0,0,0,0.20);">

            <MudText Typo="Typo.h6" Style="font-weight:700; color:#1A237E; margin-bottom:4px;">
                Submit Appeal
            </MudText>
            <MudText Style="font-size:12px; color:#546E7A; margin-bottom:16px;">
                Violation: <strong>@_selectedViolation.type</strong>
            </MudText>

            <MudTextField @bind-Value="_appealText"
                          Label="Appeal reason"
                          Variant="Variant.Outlined"
                          Lines="4"
                          Placeholder="Explain why this violation should be reconsidered..."
                          Style="margin-bottom:16px;" />

            <div style="display:flex; gap:10px;">
                <MudButton Variant="Variant.Outlined"
                           FullWidth="true"
                           OnClick="CloseAppealDialog"
                           Style="border-color:#90A4AE; color:#546E7A; text-transform:none;">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           FullWidth="true"
                           Color="Color.Primary"
                           OnClick="SubmitAppeal"
                           Disabled="_isSubmitting"
                           Style="text-transform:none;">
                    @(_isSubmitting ? "Submitting…" : "Submit")
                </MudButton>

            </div>
        </div>
    </div>
}

@* ══════════ LOGOUT CONFIRM DIALOG ══════════ *@
@if (_showLogoutDialog)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.5);
                z-index:1000; display:flex; align-items:center; justify-content:center;
                padding:16px;">
        <div style="background:#FFFFFF; border-radius:20px; padding:24px;
                    width:100%; max-width:360px;
                    box-shadow:0 20px 60px rgba(0,0,0,0.20);">

            <div style="display:flex; flex-direction:column; align-items:center;
                        text-align:center; margin-bottom:20px;">
                <div style="width:52px; height:52px; border-radius:50%;
                            background:linear-gradient(135deg,#E1F5FE,#B3E5FC);
                            border:1px solid #81D4FA;
                            display:flex; align-items:center; justify-content:center;
                            margin-bottom:12px;
                            box-shadow:0 4px 8px rgba(2,136,209,0.15);">
                    <MudIcon Icon="@Icons.Material.Filled.Logout"
                             Style="color:#0288D1; font-size:26px;" />
                </div>
                <MudText Typo="Typo.h6"
                         Style="font-weight:700; color:#1A237E; margin-bottom:4px;">
                    Log Out?
                </MudText>
                <MudText Style="font-size:12px; color:#546E7A;">
                    Are you sure you want to log out of your account?
                </MudText>
            </div>

            <div style="display:flex; gap:10px;">
                <MudButton Variant="Variant.Outlined"
                           FullWidth="true"
                           OnClick="CloseLogoutDialog"
                           Style="border-color:#90A4AE; color:#546E7A;
                                  text-transform:none; border-radius:10px;">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           FullWidth="true"
                           OnClick="ConfirmLogout"
                           Style="background:#0288D1; color:#FFFFFF;
                                  text-transform:none; font-weight:600;
                                  border-radius:10px;
                                  box-shadow:0 4px 8px rgba(2,136,209,0.25);">
                    Log Out
                </MudButton>
            </div>

        </div>
    </div>
}


    @code {
    private int _activeTab = 0;
    private bool _isLoading = true;
    private bool _showAppealDialog = false;
    private bool _isSubmitting = false;
    private bool _showLogoutDialog = false;

    private StudentDashboardData? _dashboard;
    private StudentProfileData? _profile;
    private StudentQrData? _qr;

    private ViolationItem? _selectedViolation;
    private string _appealText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            // Run all three in parallel for speed
            var violationsTask = StudentService.GetViolationsAsync();
            var profileTask = StudentService.GetProfileAsync();
            var qrTask = StudentService.GetQrCodeAsync();

            await Task.WhenAll(violationsTask, profileTask, qrTask);

            var violationsResult = await violationsTask;
            if (violationsResult.Status == 200)
                _dashboard = violationsResult.Data;
            else
                Snackbar.Add($"Violations: {violationsResult.Message}", Severity.Warning);

            var profileResult = await profileTask;
            if (profileResult.Status == 200)
                _profile = profileResult.Data;
            else
                Snackbar.Add($"Profile: {profileResult.Message}", Severity.Warning);

            var qrResult = await qrTask;
            if (qrResult.Status == 200)
                _qr = qrResult.Data;
            // QR not found is non-critical — silent
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void SetTab(int idx) => _activeTab = idx;

    private void OpenAppealDialog(ViolationItem violation)
    {
        _selectedViolation = violation;
        _appealText = string.Empty;
        _showAppealDialog = true;
    }

    private void CloseAppealDialog()
    {
        _showAppealDialog = false;
        _selectedViolation = null;
    }

    private async Task SubmitAppeal()
    {
        if (string.IsNullOrWhiteSpace(_appealText))
        {
            Snackbar.Add("Please enter your appeal reason.", Severity.Warning);
            return;
        }

        _isSubmitting = true;
        var result = await StudentService.SubmitAppealAsync(
            _selectedViolation!.id,
            new SubmitAppealRequest { AppealText = _appealText.Trim() }
        );
        _isSubmitting = false;

        if (result.Status == 200)
        {
            Snackbar.Add("Appeal submitted successfully!", Severity.Success);
            CloseAppealDialog();
            await LoadAllDataAsync(); // Refresh to show updated appeal_status
        }
        else
        {
            Snackbar.Add(result.Message ?? "Failed to submit appeal.", Severity.Error);
        }
    }

