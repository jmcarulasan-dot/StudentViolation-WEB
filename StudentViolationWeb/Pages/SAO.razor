@code {
    private int _activeTab = 0;

    // Tab 0 — Summary
    private SaoSummaryData? _summary;
    private bool _isLoadingSummary = false;

    // Tab 1 — Violations
    private List<SaoViolationItem>? _violations;
    private bool _isLoadingViolations = false;
    private string _violationSearch = string.Empty;

    // Tab 2 — Appeals
    private List<SaoViolationItem>? _appeals;
    private bool _isLoadingAppeals = false;

    // Tab 3 — Users
    private List<SaoUserItem>? _users;
    private bool _isLoadingUsers = false;
    private string _userSearch = string.Empty;
    private SaoUserDetail? _editUser;
    private UpdateUserRequest _editRequest = new();
    private bool _showEditUser = false;
    private bool _isSavingUser = false;

    // Tab 4 — Dismissals
    private List<PendingDismissalItem>? _dismissals;
    private bool _isLoadingDismissals = false;

    // Dismissed students
    private List<PendingDismissalItem>? _dismissedStudents;
    private bool _isLoadingDismissed = false;

    // Appeal review
    private bool _showAppealDialog = false;
    private int _reviewingViolationId;
    private string _reviewingViolationType = string.Empty;
    private string _appealReviewStatus = "Approved";
    private string _appealRemarks = string.Empty;
    private bool _isReviewing = false;

    // Delete confirm
    private bool _showDeleteConfirm = false;
    private string _deleteConfirmMessage = string.Empty;
    private bool _isDeleting = false;
    private Func<Task>? _deleteAction;

    private bool _showLogoutDialog = false;
    private string _studentLookupNo = string.Empty;
    private string _auditStudentNo = string.Empty;
    private SaoStudentReport? _studentReport;
    private SaoViolationLevelResponse? _studentLevel;
    private List<SaoAuditEntry>? _auditEntries;
    private bool _isLoadingStudent;
    private bool _isLoadingAudit;
    private bool _studentActionBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
    }

    private async Task SwitchTab(int idx)
    {
        _activeTab = idx;
        if (idx == 0) await LoadSummaryAsync();
        if (idx == 1) await LoadViolationsAsync();
        if (idx == 2) await LoadAppealsAsync();
        if (idx == 3) await LoadUsersAsync();
        if (idx == 4)
        {
            await LoadDismissalsAsync();
            await LoadDismissedStudentsAsync();
        }
        if (idx == 6) await LoadAuditHistory();
    }

    private async Task LoadSummaryAsync()
    {
        _isLoadingSummary = true;
        var result = await SaoService.GetSummaryAsync();
        if (result.Status == 200) _summary = result.Data;
        _isLoadingSummary = false;
    }

    private async Task LoadViolationsAsync()
    {
        _isLoadingViolations = true;
        var result = await SaoService.GetAllViolationsAsync();
        if (result.Status == 200) _violations = result.Data;
        _isLoadingViolations = false;
    }

    private async Task LoadAppealsAsync()
    {
        _isLoadingAppeals = true;
        var result = await SaoService.GetPendingAppealsAsync();
        if (result.Status == 200) _appeals = result.Data;
        else _appeals = new List<SaoViolationItem>();
        _isLoadingAppeals = false;
    }

    private async Task LoadUsersAsync()
    {
        _isLoadingUsers = true;
        var result = await SaoService.GetAllUsersAsync();
        if (result.Status == 200) _users = result.Data?.Where(u => !string.Equals(u.role, "Guidance", StringComparison.OrdinalIgnoreCase)).ToList();
        _isLoadingUsers = false;
    }

    private async Task LoadDismissalsAsync()
    {
        _isLoadingDismissals = true;
        var result = await SaoService.GetPendingDismissalsAsync();
        if (result.Status == 200) _dismissals = result.Data;
        else _dismissals = new List<PendingDismissalItem>();
        _isLoadingDismissals = false;
    }

    // ── Violations ──────────────────────────────────────────────────────────
    private async Task ApproveViolation(int id)
    {
        var result = await SaoService.ApproveViolationAsync(id);
        if (result.Status == 200)
        {
            Snackbar.Add("Violation approved.", Severity.Success);
            _violations = null;
            await LoadViolationsAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

    private async Task RejectViolation(int id)
    {
        var result = await SaoService.RejectViolationAsync(id);
        if (result.Status == 200)
        {
            Snackbar.Add("Violation rejected.", Severity.Success);
            _violations = null;
            await LoadViolationsAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

    private void ConfirmDeleteViolation(int id, string? type)
    {
        _deleteConfirmMessage = $"Are you sure you want to delete the violation \"{type}\"? This cannot be undone.";
        _deleteAction = async () => await ExecuteDeleteViolation(id);
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteViolation(int id)
    {
        _isDeleting = true;
        var result = await SaoService.DeleteViolationAsync(id);
        _isDeleting = false;
        _showDeleteConfirm = false;
        if (result.Status == 200)
        {
            Snackbar.Add("Violation deleted.", Severity.Success);
            _violations = null;
            await LoadViolationsAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

    private async Task ExecuteDelete()
    {
        if (_deleteAction != null) await _deleteAction();
    }

