@page "/sao/dashboard"
@inject NavigationManager Nav
@inject AuthService AuthService
@inject SaoService SaoService
@inject SaoOperationsService SaoOperationsService
@inject ISnackbar Snackbar

<PageTitle>SAO Dashboard</PageTitle>

<MudLayout Class="sao-app">
    <aside class="sao-sidebar">
        <div class="brand-lockup">
            <div class="brand-symbol"><MudIcon Icon="@Icons.Material.Filled.Shield" /></div>
            <div><strong>SVS</strong><span>STUDENT VIOLATION SYSTEM</span></div>
        </div>
        <div class="workspace-label">WORKSPACE</div>
        <nav class="side-nav" aria-label="SAO navigation">
            <button @onclick="() => SwitchTab(0)" style="@NavBtn(0)"><MudIcon Icon="@Icons.Material.Filled.Dashboard" Style="@NavIcon(0)" /><span style="@NavLabel(0)">Overview</span></button>
            <button @onclick="() => SwitchTab(1)" style="@NavBtn(1)"><MudIcon Icon="@Icons.Material.Filled.ReportProblem" Style="@NavIcon(1)" /><span style="@NavLabel(1)">Violations</span></button>
            <button @onclick="() => SwitchTab(2)" style="@NavBtn(2)"><MudIcon Icon="@Icons.Material.Filled.Gavel" Style="@NavIcon(2)" /><span style="@NavLabel(2)">Appeals</span></button>
            <button @onclick="() => SwitchTab(3)" style="@NavBtn(3)"><MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Style="@NavIcon(3)" /><span style="@NavLabel(3)">Accounts</span></button>
            <button @onclick="() => SwitchTab(4)" style="@NavBtn(4)"><MudIcon Icon="@Icons.Material.Filled.PersonRemove" Style="@NavIcon(4)" /><span style="@NavLabel(4)">Dismissals</span></button>
            <button @onclick="() => SwitchTab(5)" style="@NavBtn(5)"><MudIcon Icon="@Icons.Material.Filled.ManageSearch" Style="@NavIcon(5)" /><span style="@NavLabel(5)">Student cases</span></button>
            <button @onclick="() => SwitchTab(6)" style="@NavBtn(6)"><MudIcon Icon="@Icons.Material.Filled.History" Style="@NavIcon(6)" /><span style="@NavLabel(6)">Audit history</span></button>
        </nav>
        <div class="sidebar-foot">
            <div class="user-avatar">SA</div>
            <div class="user-identity"><strong>SAO Office</strong><span>Administrator</span></div>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" title="Sign out" Class="sidebar-logout" OnClick="Logout" />
        </div>
    </aside>

    <MudMainContent Class="sao-main">
        <header class="topbar">
            <div class="breadcrumb"><span>Student Affairs</span><MudIcon Icon="@Icons.Material.Filled.ChevronRight" /><strong>@(_activeTab switch { 0 => "Overview", 1 => "Violations", 2 => "Appeals", 3 => "Accounts", 4 => "Dismissals", 5 => "Student cases", _ => "Audit history" })</strong></div>
            <div class="topbar-right"><span class="status-dot"></span><span>SAO workspace</span><MudIconButton Icon="@Icons.Material.Filled.Logout" title="Sign out" Class="mobile-logout" OnClick="Logout" /></div>
        </header>

        <main class="page-content">
            @if (_activeTab == 0)
            {
                <div class="page-intro"><div><p class="eyebrow">STUDENT AFFAIRS OFFICE</p><h1>Overview</h1><p class="intro-copy">A current view of student violation records and review workload.</p></div><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadSummaryAsync">Refresh</MudButton></div>
                @if (_isLoadingSummary) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" /> }
                else if (_summary is not null)
                {
                    <section class="metric-grid">
                        <article class="metric-card"><div class="metric-icon blue"><MudIcon Icon="@Icons.Material.Filled.Assignment" /></div><div><span>Total records</span><strong>@_summary.total</strong></div></article>
                        <article class="metric-card"><div class="metric-icon amber"><MudIcon Icon="@Icons.Material.Filled.PendingActions" /></div><div><span>Pending review</span><strong>@_summary.pending</strong></div></article>
                        <article class="metric-card"><div class="metric-icon green"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div><div><span>Approved</span><strong>@_summary.approved</strong></div></article>
                        <article class="metric-card"><div class="metric-icon red"><MudIcon Icon="@Icons.Material.Filled.Cancel" /></div><div><span>Rejected</span><strong>@_summary.rejected</strong></div></article>
                    </section>
                    <section class="overview-grid">
                        <article class="panel">
                            <div class="panel-heading"><div><h2>Records by severity</h2><p>Distribution across recorded violations</p></div><MudIcon Icon="@Icons.Material.Filled.BarChart" Class="panel-heading-icon" /></div>
                            @if (_summary.by_severity?.Any() == true)
                            {
                                @foreach (var item in _summary.by_severity.OrderByDescending(x => x.count))
                                {
                                    <div class="bar-row"><span class="severity-pill" style="@SeverityBadge(item.severity)">@item.severity</span><div class="bar-track"><div class="bar-fill" style="@($"width:{Math.Max(4, Math.Min(100, (int)((double)item.count / Math.Max(1, _summary.total) * 100)))}%;background:{GetSeverityColor(item.severity)}")"></div></div><strong>@item.count</strong></div>
                                }
                            }
                            else { <div class="compact-empty">No severity data yet.</div> }
                        </article>
                        <article class="panel">
                            <div class="panel-heading"><div><h2>Most common violation types</h2><p>Top categories in the current records</p></div><MudIcon Icon="@Icons.Material.Filled.Category" Class="panel-heading-icon" /></div>
                            @if (_summary.by_type?.Any() == true)
                            {
                                @foreach (var item in _summary.by_type.OrderByDescending(x => x.count).Take(6))
                                {
                                    <div class="type-row"><span class="type-dot"></span><span class="type-name">@item.type</span><strong>@item.count</strong></div>
                                }
                            }
                            else { <div class="compact-empty">No violation types yet.</div> }
                        </article>
                    </section>
                }
                else { <div class="panel compact-empty">The summary could not be loaded.</div> }
            }
            else if (_activeTab == 1)
            {
                <div class="page-intro"><div><p class="eyebrow">RECORD MANAGEMENT</p><h1>Violations</h1><p class="intro-copy">Review reports, update their status, or remove an incorrect record.</p></div><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadViolationsAsync">Refresh</MudButton></div>
                <section class="panel">
                    <div class="table-toolbar"><div><h2>All violation records</h2><p>@(_violations?.Count ?? 0) records</p></div><MudTextField @bind-Value="_violationSearch" Placeholder="Search student or violation" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Class="table-search" /></div>
                    @if (_isLoadingViolations) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                    else
                    {
                        var rows = _violations?.Where(v => string.IsNullOrWhiteSpace(_violationSearch) || (v.student_no?.Contains(_violationSearch, StringComparison.OrdinalIgnoreCase) == true) || (v.type?.Contains(_violationSearch, StringComparison.OrdinalIgnoreCase) == true)).ToList();
                        @if (rows?.Any() == true)
                        {
                            <div class="table-scroll"><table class="svs-table"><thead><tr><th>Violation</th><th>Student</th><th>Date</th><th>Severity</th><th>Status</th><th>Actions</th></tr></thead><tbody>
                            @foreach (var v in rows)
                            {
                                <tr><td><strong>@v.type</strong><small class="cell-sub">@v.details</small></td><td>@v.student_no</td><td>@v.date.ToString("MMM d, yyyy")</td><td><span style="@SeverityBadge(v.severity)">@v.severity</span></td><td><span style="@StatusBadge(v.status)">@v.status</span></td><td><div class="row-actions">
                                    @if (v.status != "Approved") { <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="() => ApproveViolation(v.id)">Approve</MudButton> }
                                    @if (v.status != "Rejected") { <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="() => RejectViolation(v.id)">Reject</MudButton> }
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => ConfirmDeleteViolation(v.id, v.type)">Delete</MudButton>
                                </div></td></tr>
                            }
                            </tbody></table></div>
                        }
                        else { <div class="compact-empty">No violation records match this search.</div> }
                    }
                </section>
            }
            else if (_activeTab == 2)
            {
                <div class="page-intro"><div><p class="eyebrow">STUDENT REQUESTS</p><h1>Appeals</h1><p class="intro-copy">Read the student's reason and record a decision.</p></div><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAppealsAsync">Refresh</MudButton></div>
                <section class="panel">
                    <div class="table-toolbar"><div><h2>Pending appeals</h2><p>@(_appeals?.Count ?? 0) awaiting review</p></div></div>
                    @if (_isLoadingAppeals) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                    else if (_appeals?.Any() == true)
                    {
                        <div class="table-scroll"><table class="svs-table"><thead><tr><th>Student</th><th>Violation</th><th>Reason</th><th>Filed</th><th>Action</th></tr></thead><tbody>
                        @foreach (var a in _appeals)
                        {
                            <tr><td><strong>@a.student_no</strong></td><td><strong>@a.type</strong><small class="cell-sub">@a.severity · @a.status</small></td><td class="appeal-reason">@(string.IsNullOrWhiteSpace(a.appeal_text) ? "No reason provided" : a.appeal_text)</td><td>@a.date.ToString("MMM d, yyyy")</td><td><MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RateReview" OnClick="() => OpenAppealReview(a.id, a.type)">Review appeal</MudButton></td></tr>
                        }
                        </tbody></table></div>
                    }
                    else { <div class="empty-state"><div class="empty-check"><MudIcon Icon="@Icons.Material.Filled.DoneAll" /></div><strong>You're all caught up</strong><span>There are no pending appeals right now.</span></div> }
                </section>
            }
            else if (_activeTab == 3)
            {
                <div class="page-intro"><div><p class="eyebrow">ACCOUNT DIRECTORY</p><h1>Accounts</h1><p class="intro-copy">Find and maintain student and guard account details.</p></div><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadUsersAsync">Refresh</MudButton></div>
                <section class="panel">
                    <div class="table-toolbar"><div><h2>System accounts</h2><p>@(_users?.Count ?? 0) accounts</p></div><MudTextField @bind-Value="_userSearch" Placeholder="Search name, username, or role" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Class="table-search" /></div>
                    @if (_isLoadingUsers) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                    else
                    {
                        var users = _users?.Where(u => string.IsNullOrWhiteSpace(_userSearch) || (u.name?.Contains(_userSearch, StringComparison.OrdinalIgnoreCase) == true) || (u.username?.Contains(_userSearch, StringComparison.OrdinalIgnoreCase) == true) || (u.role?.Contains(_userSearch, StringComparison.OrdinalIgnoreCase) == true)).ToList();
                        @if (users?.Any() == true)
                        {
                            <div class="table-scroll"><table class="svs-table"><thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Email</th><th>Actions</th></tr></thead><tbody>
                            @foreach (var u in users)
                            {
                                <tr><td><strong>@u.name</strong></td><td>@u.username</td><td><span style="@RoleBadge(u.role)">@u.role</span></td><td>@u.email</td><td><div class="row-actions"><MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" title="Edit account" OnClick="() => OpenEditUser(u)" /><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" title="Delete account" OnClick="() => ConfirmDeleteUser(u.id, u.name)" /></div></td></tr>
                            }
                            </tbody></table></div>
                        }
                        else { <div class="compact-empty">No accounts match this search.</div> }
                    }
                </section>
            }
            else if (_activeTab == 4)
            {
                <div class="page-intro"><div><p class="eyebrow">STUDENT STATUS</p><h1>Dismissals</h1><p class="intro-copy">Review recommendations and restore students when a dismissal is cancelled.</p></div><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshDismissals">Refresh</MudButton></div>
                <section class="dismissal-grid">
                    <article class="panel"><div class="panel-heading"><div><h2>Awaiting final review</h2><p>@(_dismissals?.Count ?? 0) students</p></div><span class="count-badge warning">@(_dismissals?.Count ?? 0)</span></div>
                        @if (_isLoadingDismissals) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                        else if (_dismissals?.Any() == true)
                        {
                            <div class="compact-list">
                            @foreach (var d in _dismissals)
                            {
                                <div class="person-row"><div class="person-avatar">@if (!string.IsNullOrEmpty(d.profilePhoto)){<img src="data:image/jpeg;base64,@d.profilePhoto" alt="" />}else{@(d.FirstName?.FirstOrDefault().ToString().ToUpper() ?? "S")}</div><div class="person-data"><strong>@d.FirstName @d.LastName</strong><span>@d.StudentNo · @d.Course · Year @d.Year</span></div><div class="row-actions"><MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" OnClick="() => DismissStudent(d.StudentNo!)">Finalize</MudButton><MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" OnClick="() => CancelDismissal(d.StudentNo!)">Cancel</MudButton></div></div>
                            }
                            </div>
                        }
                        else { <div class="compact-empty">No students are awaiting dismissal review.</div> }
                    </article>
                    <article class="panel"><div class="panel-heading"><div><h2>Dismissed students</h2><p>@(_dismissedStudents?.Count ?? 0) accounts</p></div><span class="count-badge neutral">@(_dismissedStudents?.Count ?? 0)</span></div>
                        @if (_isLoadingDismissed) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                        else if (_dismissedStudents?.Any() == true)
                        {
                            <div class="compact-list">
                            @foreach (var d in _dismissedStudents)
                            {
                                <div class="person-row"><div class="person-avatar muted">@if (!string.IsNullOrEmpty(d.profilePhoto)){<img src="data:image/jpeg;base64,@d.profilePhoto" alt="" />}else{@(d.FirstName?.FirstOrDefault().ToString().ToUpper() ?? "S")}</div><div class="person-data"><strong>@d.FirstName @d.LastName</strong><span>@d.StudentNo · @d.Course · Year @d.Year</span></div><MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" OnClick="() => CancelDismissal(d.StudentNo!)">Reinstate</MudButton></div>
                            }
                            </div>
                        }
                        else { <div class="compact-empty">No dismissed students.</div> }
                    </article>
                </section>
            }
            else if (_activeTab == 5)
            {
                <div class="page-intro"><div><p class="eyebrow">STUDENT SUPPORT</p><h1>Student cases</h1><p class="intro-copy">Review a student's history and apply the action indicated by the backend.</p></div></div>
                <section class="panel search-panel"><MudTextField @bind-Value="_studentLookupNo" Label="Student number" Placeholder="Enter a student number" Variant="Variant.Outlined" Margin="Margin.Dense" /><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isLoadingStudent" StartIcon="@Icons.Material.Filled.Search" OnClick="LoadStudentCase">Find student</MudButton></section>
                @if (_isLoadingStudent) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-3" /> }
                else if (_studentReport is not null)
                {
                    <section class="case-grid">
                        <article class="panel case-summary">
                            <div class="case-header"><div class="student-avatar"><MudIcon Icon="@Icons.Material.Filled.Person" /></div><div class="case-person"><h2>@_studentReport.name</h2><p>@_studentReport.student_no · @_studentReport.course · Year @_studentReport.year</p></div><MudChip T="string" Color="@LevelColor(_studentLevel?.ViolationLevel)">@(_studentLevel?.ViolationLevel ?? "Unknown") level</MudChip></div>
                            <div class="case-stats"><div><span>Active violations</span><strong>@(_studentLevel?.ActiveViolations ?? _studentReport.violation_count)</strong></div><div><span>Recommended action</span><strong>@(_studentLevel?.RecommendedAction ?? _studentReport.recommended_action)</strong></div><div><span>Email</span><strong>@_studentReport.email</strong></div></div>
                            <h3>Violation history</h3>
                            @if (_studentReport.violations?.Any() == true)
                            {
                                <div class="table-scroll"><table class="svs-table"><thead><tr><th>Date</th><th>Violation</th><th>Severity</th><th>Status</th></tr></thead><tbody>@foreach(var v in _studentReport.violations){<tr><td>@v.date.ToString("MMM d, yyyy")</td><td><strong>@v.type</strong><small class="cell-sub">@v.details</small></td><td><span style="@SeverityBadge(v.severity)">@v.severity</span></td><td><span style="@StatusBadge(v.status)">@v.status</span></td></tr>}</tbody></table></div>
                            }
                            else { <div class="compact-empty">No violation records for this student.</div> }
                        </article>
                        <article class="panel case-actions"><h2>Case actions</h2><p>Buttons are available only when the active count meets the rule.</p>
                            <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(_studentLevel?.ActiveViolations != 1 || _studentActionBusy)" OnClick="@(()=>ApplyStudentAction("warn"))">Issue warning</MudButton>
                            <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(_studentLevel?.ActiveViolations != 2 || _studentActionBusy)" OnClick="@(()=>ApplyStudentAction("counsel"))">Assign counseling</MudButton>
                            <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Error" Disabled="@((_studentLevel?.ActiveViolations ?? 0) < 3 || _studentActionBusy)" OnClick="@(()=>ApplyStudentAction("recommend-dismiss"))">Recommend dismissal</MudButton>
                        </article>
                    </section>
                }
            }
            else
            {
                <div class="page-intro"><div><p class="eyebrow">SYSTEM RECORDS</p><h1>Audit history</h1><p class="intro-copy">Review recent administrative changes, with an optional student filter.</p></div></div>
                <section class="panel"><div class="table-toolbar"><div><h2>Recent activity</h2><p>Latest 100 entries</p></div><div class="inline-search"><MudTextField @bind-Value="_auditStudentNo" Label="Student number (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" /><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isLoadingAudit" OnClick="LoadAuditHistory">Search</MudButton></div></div>
                    @if (_isLoadingAudit) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                    else if (_auditEntries?.Any() == true)
                    {
                        <div class="table-scroll"><table class="svs-table"><thead><tr><th>Time</th><th>Action</th><th>Student</th><th>Actor</th><th>Details</th></tr></thead><tbody>@foreach(var item in _auditEntries){<tr><td>@item.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td><td><strong>@item.Action</strong></td><td>@(item.StudentNo ?? "—")</td><td>@item.ActorUsername <small class="cell-sub">@item.ActorRole</small></td><td>@(item.Remarks ?? $"{item.PreviousValue ?? "—"} → {item.NewValue ?? "—"}")</td></tr>}</tbody></table></div>
                    }
                    else { <div class="compact-empty">No audit records found for this search.</div> }
                </section>
            }
        </main>
    </MudMainContent>
</MudLayout>

@if (_showEditUser && _editUser is not null)
{
    <div class="dialog-backdrop"><section class="action-dialog"><div class="dialog-heading"><div class="dialog-icon blue"><MudIcon Icon="@Icons.Material.Filled.Edit" /></div><div><h2>Edit account</h2><p>@_editUser.username</p></div></div>
        <MudTextField @bind-Value="_editRequest.FirstName" Label="First name" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_editRequest.LastName" Label="Last name" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_editRequest.Email" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_editRequest.ContactNumber" Label="Contact number" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_editRequest.Address" Label="Address" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudSelect @bind-Value="_editRequest.Gender" Label="Gender" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("male")">Male</MudSelectItem><MudSelectItem Value="@("female")">Female</MudSelectItem></MudSelect>
        <div class="dialog-actions"><MudButton Variant="Variant.Text" OnClick="CloseEditUser">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSavingUser" OnClick="SaveUser">Save changes</MudButton></div>
    </section></div>
}
@if (_showAppealDialog)
{
    <div class="dialog-backdrop"><section class="action-dialog"><div class="dialog-heading"><div class="dialog-icon amber"><MudIcon Icon="@Icons.Material.Filled.Gavel" /></div><div><h2>Review appeal</h2><p>@_reviewingViolationType</p></div></div>
        <MudSelect @bind-Value="_appealReviewStatus" Label="Decision" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("Approved")">Approve appeal</MudSelectItem><MudSelectItem Value="@("Rejected")">Reject appeal</MudSelectItem></MudSelect>
        <MudTextField @bind-Value="_appealRemarks" Label="Remarks" Variant="Variant.Outlined" Lines="3" Margin="Margin.Dense" />
        <div class="dialog-actions"><MudButton Variant="Variant.Text" OnClick="CloseAppealDialog">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isReviewing" OnClick="SubmitAppealReview">Save decision</MudButton></div>
    </section></div>
}
@if (_showDeleteConfirm)
{
    <div class="dialog-backdrop"><section class="action-dialog confirm-dialog"><div class="dialog-icon red"><MudIcon Icon="@Icons.Material.Filled.DeleteOutline" /></div><h2>Confirm deletion</h2><p>@_deleteConfirmMessage</p><div class="dialog-actions"><MudButton Variant="Variant.Text" OnClick="@(()=>_showDeleteConfirm=false)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_isDeleting" OnClick="ExecuteDelete">Delete</MudButton></div></section></div>
}
@if (_showLogoutDialog)
{
    <div class="dialog-backdrop"><section class="action-dialog confirm-dialog"><div class="dialog-icon blue"><MudIcon Icon="@Icons.Material.Filled.Logout" /></div><h2>Sign out?</h2><p>Are you sure you want to sign out of the SAO workspace?</p><div class="dialog-actions"><MudButton Variant="Variant.Text" OnClick="CloseLogoutDialog">Stay</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmLogout">Sign out</MudButton></div></section></div>
}

<style>
    .sao-app { min-height:100vh; background:#f3f5f9; color:#172033; }
    .sao-sidebar { position:fixed; z-index:30; inset:0 auto 0 0; width:252px; display:flex; flex-direction:column; background:#111d35; color:#d9e2f0; padding:22px 14px 14px; }
    .brand-lockup { display:flex; align-items:center; gap:12px; padding:5px 10px 26px; border-bottom:1px solid rgba(255,255,255,.09); }
    .brand-symbol { width:38px; height:38px; border-radius:11px; display:grid; place-items:center; background:#2563eb; color:#fff; font-size:21px; }
    .brand-lockup strong { display:block; color:#fff; font-size:1.12rem; letter-spacing:.04em; line-height:1.15; }
    .brand-lockup span { display:block; color:#8391a9; font-size:.57rem; letter-spacing:.12em; margin-top:4px; }
    .workspace-label { color:#7888a3; font-size:.64rem; font-weight:800; letter-spacing:.16em; padding:24px 12px 9px; }
    .side-nav { display:flex; flex-direction:column; gap:4px; }
    .side-nav button { color:#aab6c8; transition:all .15s ease; }
    .side-nav button:hover { background:rgba(255,255,255,.07)!important; color:#fff; }
    .side-nav button span { color:inherit!important; font-size:.87rem!important; font-weight:600!important; }
    .side-nav button .mud-icon-root { color:inherit!important; }
    .sidebar-foot { margin-top:auto; display:flex; align-items:center; gap:10px; padding:14px 7px 4px; border-top:1px solid rgba(255,255,255,.09); }
    .user-avatar { width:34px; height:34px; border-radius:50%; display:grid; place-items:center; color:#fff; background:#334a70; font-size:.72rem; font-weight:800; }
    .user-identity { flex:1; min-width:0; }
