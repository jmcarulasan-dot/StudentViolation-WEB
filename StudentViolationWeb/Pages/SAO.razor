        _deleteAction = async () => await ExecuteDeleteUser(id);
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteUser(int id)
    {
        _isDeleting = true;
        var result = await SaoService.DeleteUserAsync(id);
        _isDeleting = false;
        _showDeleteConfirm = false;
        if (result.Status == 200)
        {
            Snackbar.Add("User deleted.", Severity.Success);
            _users = null;
            await LoadUsersAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

