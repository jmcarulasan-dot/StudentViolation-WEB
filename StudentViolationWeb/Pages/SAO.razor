@code {
    private int _activeTab = 0;

    // Tab 0 — Summary
    private SaoSummaryData? _summary;
    private bool _isLoadingSummary = false;

    // Tab 1 — Violations
    private List<SaoViolationItem>? _violations;
    private bool _isLoadingViolations = false;
    private string _violationSearch = string.Empty;

    // Tab 2 — Appeals
    private List<SaoViolationItem>? _appeals;
    private bool _isLoadingAppeals = false;

    // Tab 3 — Users
    private List<SaoUserItem>? _users;
    private bool _isLoadingUsers = false;
    private string _userSearch = string.Empty;
    private SaoUserDetail? _editUser;
    private UpdateUserRequest _editRequest = new();
    private bool _showEditUser = false;
    private bool _isSavingUser = false;

    // Tab 4 — Dismissals
    private List<PendingDismissalItem>? _dismissals;
    private bool _isLoadingDismissals = false;

    // Dismissed students
    private List<PendingDismissalItem>? _dismissedStudents;
    private bool _isLoadingDismissed = false;

    // Appeal review
    private bool _showAppealDialog = false;
    private int _reviewingViolationId;
    private string _reviewingViolationType = string.Empty;
    private string _appealReviewStatus = "Approved";
    private string _appealRemarks = string.Empty;
    private bool _isReviewing = false;

    // Delete confirm
    private bool _showDeleteConfirm = false;
    private string _deleteConfirmMessage = string.Empty;
    private bool _isDeleting = false;
    private Func<Task>? _deleteAction;

    private bool _showLogoutDialog = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
    }

    private async Task SwitchTab(int idx)
    {
        _activeTab = idx;
        if (idx == 0) await LoadSummaryAsync();
        if (idx == 1) await LoadViolationsAsync();
        if (idx == 2) await LoadAppealsAsync();
        if (idx == 3) await LoadUsersAsync();
        if (idx == 4)
        {
            await LoadDismissalsAsync();
            await LoadDismissedStudentsAsync();
        }
    }

    private async Task LoadSummaryAsync()
    {
        _isLoadingSummary = true;
        var result = await SaoService.GetSummaryAsync();
        if (result.Status == 200) _summary = result.Data;
        _isLoadingSummary = false;
    }

    private async Task LoadViolationsAsync()
    {
        _isLoadingViolations = true;
        var result = await SaoService.GetAllViolationsAsync();
        if (result.Status == 200) _violations = result.Data;
        _isLoadingViolations = false;
    }

    private async Task LoadAppealsAsync()
    {
        _isLoadingAppeals = true;
        var result = await SaoService.GetPendingAppealsAsync();
        if (result.Status == 200) _appeals = result.Data;
        else _appeals = new List<SaoViolationItem>();
        _isLoadingAppeals = false;
    }

    private async Task LoadUsersAsync()
    {
        _isLoadingUsers = true;
        var result = await SaoService.GetAllUsersAsync();
        if (result.Status == 200) _users = result.Data;
        _isLoadingUsers = false;
    }

    private async Task LoadDismissalsAsync()
    {
        _isLoadingDismissals = true;
        var result = await SaoService.GetPendingDismissalsAsync();
        if (result.Status == 200) _dismissals = result.Data;
        else _dismissals = new List<PendingDismissalItem>();
        _isLoadingDismissals = false;
    }

    // ── Violations ──────────────────────────────────────────────────────────
    private async Task ApproveViolation(int id)
    {
        var result = await SaoService.ApproveViolationAsync(id);
        if (result.Status == 200)
        {
            Snackbar.Add("Violation approved.", Severity.Success);
            _violations = null;
            await LoadViolationsAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

    private async Task RejectViolation(int id)
    {
        var result = await SaoService.RejectViolationAsync(id);
        if (result.Status == 200)
        {
            Snackbar.Add("Violation rejected.", Severity.Success);
            _violations = null;
            await LoadViolationsAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

    private void ConfirmDeleteViolation(int id, string? type)
    {
        _deleteConfirmMessage = $"Are you sure you want to delete the violation \"{type}\"? This cannot be undone.";
        _deleteAction = async () => await ExecuteDeleteViolation(id);
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteViolation(int id)
    {
        _isDeleting = true;
        var result = await SaoService.DeleteViolationAsync(id);
        _isDeleting = false;
        _showDeleteConfirm = false;
        if (result.Status == 200)
        {
            Snackbar.Add("Violation deleted.", Severity.Success);
            _violations = null;
            await LoadViolationsAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

    private async Task ExecuteDelete()
    {
        if (_deleteAction != null) await _deleteAction();
    }

    // ── Appeals ─────────────────────────────────────────────────────────────
    private void OpenAppealReview(int id, string? type)
    {
        _reviewingViolationId = id;
        _reviewingViolationType = type ?? string.Empty;
        _appealReviewStatus = "Approved";
        _appealRemarks = string.Empty;
        _showAppealDialog = true;
    }

    private void CloseAppealDialog() => _showAppealDialog = false;

    private async Task SubmitAppealReview()
    {
        _isReviewing = true;
        var result = await SaoService.ReviewAppealAsync(
            _reviewingViolationId,
            new AppealReviewRequest { AppealStatus = _appealReviewStatus, AppealRemarks = _appealRemarks });
        _isReviewing = false;

        if (result.Status == 200)
        {
            Snackbar.Add($"Appeal {_appealReviewStatus.ToLower()}.", Severity.Success);
            CloseAppealDialog();
            _appeals = null;
            await LoadAppealsAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

    // ── Users ────────────────────────────────────────────────────────────────
    private async Task OpenEditUser(SaoUserItem user)
    {
        var detail = await SaoService.GetUserByIdAsync(user.id);
        if (detail.Status == 200)
        {
            _editUser = detail.Data;
            _editRequest = new UpdateUserRequest
            {
                FirstName = detail.Data?.first_name,
                LastName = detail.Data?.last_name,
                Email = detail.Data?.email,
                ContactNumber = detail.Data?.contact_number,
                Address = detail.Data?.address,
                Gender = detail.Data?.gender
            };
            _showEditUser = true;
        }
        else Snackbar.Add(detail.Message ?? "Failed to load user.", Severity.Error);
    }

    private void CloseEditUser() => _showEditUser = false;

    private async Task SaveUser()
    {
        if (_editUser == null) return;
        _isSavingUser = true;
        var result = await SaoService.UpdateUserAsync(_editUser.id, _editRequest);
        _isSavingUser = false;
        if (result.Status == 200)
        {
            Snackbar.Add("User updated successfully.", Severity.Success);
            CloseEditUser();
            _users = null;
            await LoadUsersAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed to update user.", Severity.Error);
    }

    private void ConfirmDeleteUser(int id, string? name)
    {
        _deleteConfirmMessage = $"Are you sure you want to permanently delete user \"{name}\"?";
        _deleteAction = async () => await ExecuteDeleteUser(id);
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteUser(int id)
    {
        _isDeleting = true;
        var result = await SaoService.DeleteUserAsync(id);
        _isDeleting = false;
        _showDeleteConfirm = false;
        if (result.Status == 200)
        {
            Snackbar.Add("User deleted.", Severity.Success);
            _users = null;
            await LoadUsersAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

    // ── Dismissals ───────────────────────────────────────────────────────────
    private async Task DismissStudent(string studentNo)
    {
        var result = await SaoService.DismissStudentAsync(studentNo);
        if (result.Status == 200)
        {
            Snackbar.Add("Student dismissed.", Severity.Success);
            _dismissals = null;
            _dismissedStudents = null;
            await LoadDismissalsAsync();
            await LoadDismissedStudentsAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

    private async Task CancelDismissal(string studentNo)
    {
        var result = await SaoService.CancelDismissalAsync(studentNo);
        if (result.Status == 200)
        {
            Snackbar.Add("Dismissal cancelled. Student reinstated.", Severity.Success);
            _dismissals = null;
            _dismissedStudents = null;
            await LoadDismissalsAsync();
            await LoadDismissedStudentsAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed.", Severity.Error);
    }

    private void Logout() => _showLogoutDialog = true;

    private void CloseLogoutDialog() => _showLogoutDialog = false;

    private async Task ConfirmLogout()
    {
        _showLogoutDialog = false;
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    private async Task LoadDismissedStudentsAsync()
    {
        _isLoadingDismissed = true;
        var result = await SaoService.GetDismissedStudentsAsync();
        if (result.Status == 200) _dismissedStudents = result.Data;
        else _dismissedStudents = new List<PendingDismissalItem>();
        _isLoadingDismissed = false;
    }

    // ── Nav helpers ──────────────────────────────────────────────────────────
    private string NavBtn(int i) =>
        "flex:1; display:flex; flex-direction:column; align-items:center; " +
        "justify-content:center; gap:3px; border:none; " +
        $"background:{(_activeTab == i ? "#E1F5FE" : "transparent")}; " +
        "cursor:pointer; padding:6px 4px; border-radius:12px; height:56px;";

    private string NavIcon(int i) =>
        $"font-size:20px; color:{(_activeTab == i ? "#0288D1" : "#90A4AE")};";

    private string NavLabel(int i) =>
        $"font-size:10px; font-weight:{(_activeTab == i ? "700" : "400")}; " +
        $"color:{(_activeTab == i ? "#0288D1" : "#90A4AE")}; font-family:inherit;";

    // ── Badge helpers ────────────────────────────────────────────────────────
    private string SeverityBadge(string? s) => (s?.ToLower()) switch
    {
        "critical" => "padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; background:rgba(229,57,53,0.10); border:1px solid rgba(229,57,53,0.4); color:#E53935;",
        "major" => "padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; background:rgba(249,168,37,0.12); border:1px solid rgba(249,168,37,0.4); color:#F9A825;",
        "moderate" => "padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; background:rgba(2,136,209,0.10); border:1px solid rgba(2,136,209,0.35); color:#0288D1;",
        _ => "padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; background:rgba(96,125,139,0.10); border:1px solid rgba(96,125,139,0.35); color:#607D8B;"
    };

    private string StatusBadge(string? s) => s switch
    {
        "Approved" => "padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; background:#E8F5E9; border:1px solid #A5D6A7; color:#2E7D32;",
        "Pending" => "padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; background:#FFF8E1; border:1px solid #FFE082; color:#F9A825;",
        _ => "padding:2px 8px; border-radius:20px; font-size:10px; font-weight:600; background:#FFEBEE; border:1px solid #FFCDD2; color:#E53935;"
    };

    private string RoleBadge(string? r) => r?.ToLower() switch
    {
        "guard" => "padding:1px 8px; border-radius:20px; font-size:10px; font-weight:600; background:#E8F5E9; border:1px solid #A5D6A7; color:#2E7D32;",
        "student" => "padding:1px 8px; border-radius:20px; font-size:10px; font-weight:600; background:#E3F2FD; border:1px solid #90CAF9; color:#1565C0;",
        "guidance" => "padding:1px 8px; border-radius:20px; font-size:10px; font-weight:600; background:#EDE7F6; border:1px solid #CE93D8; color:#6A1B9A;",
        "sao" => "padding:1px 8px; border-radius:20px; font-size:10px; font-weight:600; background:#E1F5FE; border:1px solid #B3E5FC; color:#0288D1;",
        _ => "padding:1px 8px; border-radius:20px; font-size:10px; font-weight:600; background:#ECEFF1; border:1px solid #CFD8DC; color:#607D8B;"
    };

    private string GetSeverityColor(string? s) => s?.ToLower() switch
    {
        "critical" => "#E53935",
        "major" => "#F9A825",
        "moderate" => "#0288D1",
        _ => "#607D8B"
    };
}
