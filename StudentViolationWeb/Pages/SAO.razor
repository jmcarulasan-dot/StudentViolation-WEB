    // ── Users ────────────────────────────────────────────────────────────────
    private async Task OpenEditUser(SaoUserItem user)
    {
        var detail = await SaoService.GetUserByIdAsync(user.id);
        if (detail.Status == 200)
        {
            _editUser = detail.Data;
            _editRequest = new UpdateUserRequest
            {
                FirstName = detail.Data?.first_name,
                LastName = detail.Data?.last_name,
                Email = detail.Data?.email,
                ContactNumber = detail.Data?.contact_number,
                Address = detail.Data?.address,
                Gender = detail.Data?.gender
            };
            _showEditUser = true;
        }
        else Snackbar.Add(detail.Message ?? "Failed to load user.", Severity.Error);
    }

    private void CloseEditUser() => _showEditUser = false;

    private async Task SaveUser()
    {
        if (_editUser == null) return;
        _isSavingUser = true;
        var result = await SaoService.UpdateUserAsync(_editUser.id, _editRequest);
        _isSavingUser = false;
        if (result.Status == 200)
        {
            Snackbar.Add("User updated successfully.", Severity.Success);
            CloseEditUser();
            _users = null;
            await LoadUsersAsync();
        }
        else Snackbar.Add(result.Message ?? "Failed to update user.", Severity.Error);
    }

