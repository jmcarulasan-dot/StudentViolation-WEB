@page "/sao/dashboard"
@inject NavigationManager Nav
@inject AuthService AuthService
@inject SaoService SaoService
@inject SaoOperationsService SaoOperationsService
@inject ISnackbar Snackbar

<PageTitle>SAO Dashboard</PageTitle>

<MudLayout>

    @* ── Top Bar ── *@
    <MudAppBar Elevation="0"
               Style="background:rgba(255,255,255,0.95);
                      backdrop-filter:blur(20px);
                      border-bottom:1px solid #E1F5FE;">
        <MudSpacer />
        <MudText Typo="Typo.h6"
                 Style="font-weight:700; color:#0288D1; letter-spacing:0.02em;">
            Student Affairs Office
        </MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       OnClick="Logout"
                       Style="color:#546E7A;" />
    </MudAppBar>

    <MudMainContent Class="sao-main-content" Style="background:#F4F9FD; min-height:100vh; padding-bottom:80px;">

        <div style="position:fixed; inset:0;
                    background:radial-gradient(ellipse 60% 50% at 0% 0%, #E1F5FE 0%, transparent 60%),
                               radial-gradient(ellipse 40% 40% at 100% 100%, #B3E5FC 0%, transparent 60%);
                    pointer-events:none; z-index:0;"></div>
        <div style="position:fixed; inset:0;
                    background-image:radial-gradient(#B3E5FC 1px, transparent 1px);
                    background-size:24px 24px;
                    pointer-events:none; z-index:0; opacity:0.45;"></div>

        <div style="position:relative; z-index:1; padding:16px 16px 0;">

            @* ══════════ TAB 0 — OVERVIEW ══════════ *@
            @if (_activeTab == 0)
            {
                <div style="background:linear-gradient(135deg,#FFFFFF,#E1F5FE);
                                        border:1px solid #B3E5FC; border-radius:16px;
                                        padding:16px 20px; margin-bottom:18px;
                                        display:flex; align-items:center; gap:16px;
                                        box-shadow:0 4px 12px rgba(2,136,209,0.08);">
                    <div style="width:44px; height:44px; border-radius:12px;
                                            background:#0288D1;
                                            display:flex; align-items:center; justify-content:center;
                                            flex-shrink:0;">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Style="color:#FFFFFF; font-size:22px;" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#0288D1; font-size:14px;">
                            System Overview
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#546E7A; font-size:11px;">
                            Violations summary across the system
                        </MudText>
                    </div>
                </div>

                @if (_isLoadingSummary)
                {
                    <div style="text-align:center; padding:40px;">
                        <MudProgressCircular Indeterminate="true" Style="color:#0288D1;" />
                    </div>
                }
                else if (_summary != null)
                {
                    @* Stats Row *@
                    <div style="display:flex; gap:8px; margin-bottom:14px; flex-wrap:wrap;">
                        @foreach (var stat in new[]
                                        {
                                (_summary.total.ToString(),    "Total",    "#0288D1", "#B3E5FC"),
                                (_summary.pending.ToString(),  "Pending",  "#F9A825", "#FFE082"),
                                (_summary.approved.ToString(), "Approved", "#2E7D32", "#A5D6A7"),
                                (_summary.rejected.ToString(), "Rejected", "#E53935", "#FFCDD2")
                                })
                        {
                            <div style="flex:1; min-width:70px; background:#FFFFFF;
                                                                            border:1px solid @stat.Item4;
                                                                            border-radius:12px; padding:12px 8px;
                                                                            text-align:center;
                                                                            box-shadow:0 2px 6px rgba(2,136,209,0.06);">
                                <MudText Style="@($"font-size:1.4rem; font-weight:700; color:{stat.Item3}; line-height:1.1;")">
                                    @stat.Item1
                                </MudText>
                                <MudText Style="font-size:10px; color:#90A4AE; margin-top:2px; font-weight:600;
                                                                                   text-transform:uppercase; letter-spacing:0.04em;">
                                    @stat.Item2
                                </MudText>
                            </div>
                        }
                    </div>

                    @* By Severity *@
                    @if (_summary.by_severity?.Any() == true)
                    {
                        <div style="background:#FFFFFF; border:1px solid #E1F5FE;
                                                                        border-radius:14px; padding:16px; margin-bottom:14px;
                                                                        box-shadow:0 2px 8px rgba(2,136,209,0.06);">
                            <MudText Style="font-size:12px; font-weight:700; color:#546E7A;
                                                                               text-transform:uppercase; margin-bottom:10px;">
                                By Severity
                            </MudText>
                            @foreach (var item in _summary.by_severity)
                            {
                                <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                                    <span style="@SeverityBadge(item.severity); min-width:70px; text-align:center;">
                                        @item.severity
                                    </span>
                                    <div style="flex:1; background:#F5F5F5; border-radius:20px; height:8px; overflow:hidden;">
                                        <div style="@($"width:{Math.Min(100, (int)((double)item.count / (_summary.total > 0 ? _summary.total : 1) * 100))}%; height:8px; background:{GetSeverityColor(item.severity)}; border-radius:20px; transition:width 0.3s;")"></div>
                                    </div>
                                    <MudText Style="font-size:12px; font-weight:700; color:#1A237E; min-width:24px; text-align:right;">
                                        @item.count
                                    </MudText>
                                </div>
                            }
                        </div>
                    }

                    @* By Type *@
                    @if (_summary.by_type?.Any() == true)
                    {
                        <div style="background:#FFFFFF; border:1px solid #E1F5FE;
                                                                        border-radius:14px; padding:16px; margin-bottom:14px;
                                                                        box-shadow:0 2px 8px rgba(2,136,209,0.06);">
                            <MudText Style="font-size:12px; font-weight:700; color:#546E7A;
                                                                               text-transform:uppercase; margin-bottom:10px;">
                                By Violation Type
                            </MudText>
                            @foreach (var item in _summary.by_type.OrderByDescending(x => x.count).Take(5))
                            {
                                <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                                    <MudText Style="font-size:12px; color:#1A237E; flex:1;">@item.type</MudText>
                                    <span style="background:#E1F5FE; border:1px solid #B3E5FC;
                                                                                                 border-radius:20px; padding:2px 10px;
                                                                                                 font-size:11px; font-weight:700; color:#0288D1;">
                                        @item.count
                                    </span>
                                </div>
                            }
                        </div>
                    }
                }
            }

            @* ══════════ TAB 1 — VIOLATIONS ══════════ *@
            @if (_activeTab == 1)
            {
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
                    <div style="width:4px; height:20px; background:#0288D1; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.Report" Style="color:#0288D1; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        All Violations
                    </MudText>
                    <MudSpacer />
                    <MudText Style="font-size:11px; color:#90A4AE;">@(_violations?.Count ?? 0) records</MudText>
                </div>

                <MudTextField @bind-Value="_violationSearch"
                              Placeholder="Search by student no or type..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Style="margin-bottom:12px; background:#FFFFFF; border-radius:12px;" />

                @if (_isLoadingViolations)
                {
                    <div style="text-align:center; padding:40px;">
                        <MudProgressCircular Indeterminate="true" Style="color:#0288D1;" />
                    </div>
                }
                else
                {
                    <div style="background:#FFFFFF; border:1px solid #B3E5FC;
                                                        border-radius:16px; overflow:hidden;
                                                        box-shadow:0 2px 10px rgba(2,136,209,0.06);">
                        @{
                            var filtered = _violations?
                            .Where(v =>
                            string.IsNullOrEmpty(_violationSearch) ||
                            (v.student_no?.Contains(_violationSearch, StringComparison.OrdinalIgnoreCase) == true) ||
                            (v.type?.Contains(_violationSearch, StringComparison.OrdinalIgnoreCase) == true))
                            .ToList();
                        }

                        @if (filtered?.Any() == true)
                        {
                            @foreach (var v in filtered)
                            {
                                <div style="padding:14px 18px; border-bottom:1px solid #F0F7FF;">
                                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                                        <div style="flex:1; min-width:0;">
                                            <MudText Style="font-size:13px; font-weight:600; color:#1A237E;
                                                                                                           white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                                @v.type
                                            </MudText>
                                            <MudText Style="font-size:11px; color:#90A4AE;">
                                                @v.student_no  ·  @v.date.ToString("MMM dd, yyyy")
                                            </MudText>
                                        </div>
                                        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:4px;">
                                            <span style="@SeverityBadge(v.severity)">@v.severity</span>
                                            <span style="@StatusBadge(v.status)">@v.status</span>
                                        </div>
                                    </div>

                                    @* Action buttons *@
                                    <div style="display:flex; gap:6px; flex-wrap:wrap;">
                                        @if (v.status != "Approved")
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Size="Size.Small"
                                                       OnClick="() => ApproveViolation(v.id)"
                                                       Style="font-size:10px; height:24px; border-color:#2E7D32; color:#2E7D32; text-transform:none;">
                                                Approve
                                            </MudButton>
                                        }
                                        @if (v.status != "Rejected")
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Size="Size.Small"
                                                       OnClick="() => RejectViolation(v.id)"
                                                       Style="font-size:10px; height:24px; border-color:#F9A825; color:#F9A825; text-transform:none;">
                                                Reject
                                            </MudButton>
                                        }
                                        <MudButton Variant="Variant.Outlined"
                                                   Size="Size.Small"
                                                   OnClick="() => ConfirmDeleteViolation(v.id, v.type)"
                                                   Style="font-size:10px; height:24px; border-color:#E53935; color:#E53935; text-transform:none;">
                                            Delete
                                        </MudButton>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="padding:40px; text-align:center;">
                                <MudText Style="color:#90A4AE;">No violations found.</MudText>
                            </div>
                        }
                    </div>
                }
            }

            @* ══════════ TAB 2 — APPEALS ══════════ *@
            @if (_activeTab == 2)
            {
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
                    <div style="width:4px; height:20px; background:#E65100; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.Gavel" Style="color:#E65100; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        Pending Appeals
                    </MudText>
                </div>

                @if (_isLoadingAppeals)
                {
                    <div style="text-align:center; padding:40px;">
                        <MudProgressCircular Indeterminate="true" Style="color:#E65100;" />
                    </div>
                }
                else if (_appeals?.Any() == true)
                {
                    @foreach (var a in _appeals)
                    {
                        <div style="background:#FFFFFF; border:1px solid #B3E5FC;
                                                                        border-radius:14px; padding:16px 18px; margin-bottom:12px;
                                                                        box-shadow:0 2px 8px rgba(2,136,209,0.06);">
                            <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
                                <div style="flex:1;">
                                    <MudText Style="font-size:13px; font-weight:600; color:#1A237E;">@a.type</MudText>
                                    <MudText Style="font-size:11px; color:#90A4AE;">
                                        @a.student_no  ·  @a.date.ToString("MMM dd, yyyy")
                                    </MudText>
                                </div>
                                <span style="@SeverityBadge(a.severity)">@a.severity</span>
                            </div>

                            @if (!string.IsNullOrEmpty(a.appeal_text))
                            {
                                <div style="background:#FFF3E0; border:1px solid #FFE0B2;
                                                                                            border-radius:8px; padding:10px 12px; margin-bottom:10px;">
                                    <MudText Style="font-size:10px; color:#E65100; font-weight:600; margin-bottom:4px;">
                                        APPEAL REASON
                                    </MudText>
                                    <MudText Style="font-size:12px; color:#795548;">@a.appeal_text</MudText>
                                </div>
                            }

                            <MudButton Variant="Variant.Filled"
                                       FullWidth="true"
                                       Size="Size.Small"
                                       OnClick="() => OpenAppealReview(a.id, a.type)"
                                       Style="background:#0288D1; color:#FFFFFF; text-transform:none; font-size:11px; border-radius:8px;">
                                Review Appeal
                            </MudButton>
                        </div>
                    }
                }
                else
                {
                    <div style="background:#FFFFFF; border:1px solid #B3E5FC;
                                                        border-radius:16px; padding:48px; text-align:center;
                                                        box-shadow:0 2px 8px rgba(2,136,209,0.06);">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline"
                                 Style="color:#4FC3F7; font-size:48px;" />
                        <MudText Style="color:#90A4AE; font-size:13px; margin-top:8px; display:block;">
                            No pending appeals.
                        </MudText>
                    </div>
                }
            }

            @* ══════════ TAB 3 — USERS ══════════ *@
            @if (_activeTab == 3)
            {
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
                    <div style="width:4px; height:20px; background:#0288D1; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Style="color:#0288D1; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        User Management
                    </MudText>
                    <MudSpacer />
                    <MudText Style="font-size:11px; color:#90A4AE;">@(_users?.Count ?? 0) users</MudText>
                </div>

                <MudTextField @bind-Value="_userSearch"
                              Placeholder="Search by name, username, or role..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Style="margin-bottom:12px; background:#FFFFFF; border-radius:12px;" />

                @if (_isLoadingUsers)
                {
                    <div style="text-align:center; padding:40px;">
                        <MudProgressCircular Indeterminate="true" Style="color:#0288D1;" />
                    </div>
                }
                else
                {
                    <div style="background:#FFFFFF; border:1px solid #B3E5FC;
                                                        border-radius:16px; overflow:hidden;
                                                        box-shadow:0 2px 10px rgba(2,136,209,0.06);">
                        @{
                            var filtered = _users?
                            .Where(u =>
                            string.IsNullOrEmpty(_userSearch) ||
                            (u.name?.Contains(_userSearch, StringComparison.OrdinalIgnoreCase) == true) ||
                            (u.username?.Contains(_userSearch, StringComparison.OrdinalIgnoreCase) == true) ||
                            (u.role?.Contains(_userSearch, StringComparison.OrdinalIgnoreCase) == true))
                            .ToList();
                        }

                        @if (filtered?.Any() == true)
                        {
                            @foreach (var u in filtered)
                            {
                                <div style="padding:12px 18px; border-bottom:1px solid #F0F7FF;
                                                                                            display:flex; align-items:center; gap:12px;">
                                    <div style="width:38px; height:38px; border-radius:50%;
                                                                                                background:linear-gradient(135deg,#B3E5FC,#81D4FA);
                                                                                                border:1px solid #4FC3F7;
                                                                                                display:flex; align-items:center; justify-content:center;
                                                                                                font-size:14px; font-weight:700; color:#0288D1;
                                                                                                flex-shrink:0;">
                                        @if (!string.IsNullOrEmpty(u.profile_photo))
                                        {
                                            <img src="data:image/jpeg;base64,@u.profile_photo"
                                                 style="width:38px; height:38px; object-fit:cover; border-radius:50%;" />
                                        }
                                        else
                                        {
                                            @(u.name?.Substring(0, 1).ToUpper() ?? "U")
                                        }
                                    </div>
                                    <div style="flex:1; min-width:0;">
                                        <div style="display:flex; align-items:center; gap:6px;">
                                            <MudText Style="font-size:13px; font-weight:600; color:#1A237E;
                                                                                                           white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:140px;">
                                                @u.name
                                            </MudText>
                                            <span style="@RoleBadge(u.role)">@u.role</span>
                                        </div>
                                        <MudText Style="font-size:11px; color:#90A4AE;">
                                            @@@u.username  ·  @u.email
                                        </MudText>
                                    </div>
                                    <div style="display:flex; flex-direction:column; gap:4px;">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       OnClick="() => OpenEditUser(u)"
                                                       Style="color:#0288D1; padding:4px;" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       OnClick="() => ConfirmDeleteUser(u.id, u.name)"
                                                       Style="color:#E53935; padding:4px;" />
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="padding:40px; text-align:center;">
                                <MudText Style="color:#90A4AE;">No users found.</MudText>
                            </div>
                        }
                    </div>
                }
            }

            @* ══════════ TAB 4 — DISMISSALS ══════════ *@
            @if (_activeTab == 4)
            {
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
                    <div style="width:4px; height:20px; background:#E53935; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.PersonRemove" Style="color:#E53935; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        Pending Dismissals
                    </MudText>
                </div>

                @if (_isLoadingDismissals)
                {
                    <div style="text-align:center; padding:40px;">
                        <MudProgressCircular Indeterminate="true" Style="color:#E53935;" />
                    </div>
                }
                else if (_dismissals?.Any() == true)
                {
                    @foreach (var d in _dismissals)
                    {
                        <div style="background:#FFFFFF; border:1px solid #FFCDD2;
                                                                        border-radius:14px; padding:16px 18px; margin-bottom:12px;
                                                                        box-shadow:0 2px 8px rgba(229,57,53,0.08);">
                            <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
                                <div style="width:40px; height:40px; border-radius:50%; flex-shrink:0; overflow:hidden;">
                                    @if (!string.IsNullOrEmpty(d.profilePhoto))
                                    {
                                        <img src="data:image/jpeg;base64,@d.profilePhoto"
                                             style="width:40px; height:40px; object-fit:cover; border-radius:50%;" />
                                    }
                                    else
                                    {
                                        <div style="width:40px; height:40px; border-radius:50%;
                                    background:#FFEBEE; border:1px solid #FFCDD2;
                                    display:flex; align-items:center; justify-content:center;
                                    font-size:15px; font-weight:700; color:#E53935;">
                                            @(d.FirstName?.Substring(0, 1).ToUpper() ?? "S")
                                        </div>
                                    }
                                </div>
                                <div style="flex:1;">
                                    <MudText Style="font-weight:700; color:#1A237E; font-size:13px;">
                                        @d.FirstName @d.LastName
                                    </MudText>
                                    <MudText Style="font-size:11px; color:#90A4AE;">
                                        @d.StudentNo  ·  @d.Course  Year @d.Year
                                    </MudText>
                                </div>
                                <span style="padding:3px 10px; border-radius:20px; font-size:10px;
                                                                                 font-weight:700; background:#FFEBEE; border:1px solid #FFCDD2;
                                                                                 color:#E53935;">
                                    @d.Status
                                </span>
                            </div>

                            <div style="display:flex; gap:8px;">
                                <MudButton Variant="Variant.Filled"
                                           Size="Size.Small"
                                           OnClick="() => DismissStudent(d.StudentNo!)"
                                           Style="flex:1; background:#E53935; color:#FFFFFF; text-transform:none; font-size:11px; border-radius:8px;">
                                    Confirm Dismissal
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           OnClick="() => CancelDismissal(d.StudentNo!)"
                                           Style="flex:1; border-color:#2E7D32; color:#2E7D32; text-transform:none; font-size:11px; border-radius:8px;">
                                    Cancel / Reinstate
                                </MudButton>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="background:#FFFFFF; border:1px solid #B3E5FC;
                                                        border-radius:16px; padding:48px; text-align:center;
                                                        box-shadow:0 2px 8px rgba(2,136,209,0.06);">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline"
                                 Style="color:#4FC3F7; font-size:48px;" />
                        <MudText Style="color:#90A4AE; font-size:13px; margin-top:8px; display:block;">
                            No pending dismissals.
                        </MudText>
                    </div>
                }

                @* Dismissed Students *@
                <div style="display:flex; align-items:center; gap:10px; margin-top:20px; margin-bottom:14px;">
                    <div style="width:4px; height:20px; background:#546E7A; border-radius:4px;"></div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        Dismissed Students
                    </MudText>
                </div>

                @if (_isLoadingDismissed)
                {
                    <div style="text-align:center; padding:20px;">
                        <MudProgressCircular Indeterminate="true" Style="color:#546E7A;" />
                    </div>
                }
                else if (_dismissedStudents?.Any() == true)
                {
                    @foreach (var d in _dismissedStudents)
                    {
                        <div style="background:#FFFFFF; border:1px solid #B3E5FC;
                                border-radius:14px; padding:16px 18px; margin-bottom:12px;
                                box-shadow:0 2px 8px rgba(2,136,209,0.06);">
                            <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
                                <div style="width:40px; height:40px; border-radius:50%; flex-shrink:0; overflow:hidden;">
                                    @if (!string.IsNullOrEmpty(d.profilePhoto))
                                    {
                                        <img src="data:image/jpeg;base64,@d.profilePhoto"
                                             style="width:40px; height:40px; object-fit:cover; border-radius:50%;" />
                                    }
                                    else
                                    {
                                        <div style="width:40px; height:40px; border-radius:50%;
                                                    background:linear-gradient(135deg,#B3E5FC,#81D4FA);
                                                    border:1px solid #4FC3F7;
                                                    display:flex; align-items:center; justify-content:center;
                                                    font-size:15px; font-weight:700; color:#0288D1;">
                                            @(d.FirstName?.Substring(0, 1).ToUpper() ?? "S")
                                        </div>
                                    }
                                </div>
                                <div style="flex:1;">
                                    <MudText Style="font-weight:700; color:#1A237E; font-size:13px;">
                                        @d.FirstName @d.LastName
                                    </MudText>
                                    <MudText Style="font-size:11px; color:#90A4AE;">
                                        @d.StudentNo  ·  @d.Course  Year @d.Year
                                    </MudText>
                                </div>
                                <span style="padding:3px 10px; border-radius:20px; font-size:10px;
                                         font-weight:700; background:#ECEFF1; border:1px solid #CFD8DC;
                                         color:#546E7A;">
                                    Dismissed
                                </span>
                            </div>
                            <MudButton Variant="Variant.Outlined"
                                       FullWidth="true"
                                       Size="Size.Small"
                                       OnClick="() => CancelDismissal(d.StudentNo!)"
                                       Style="border-color:#2E7D32; color:#2E7D32; text-transform:none; font-size:11px; border-radius:8px;">
                                Reinstate Student
                            </MudButton>
                        </div>
                    }
                }
                else
                {
                    <div style="background:#FFFFFF; border:1px solid #B3E5FC;
                        border-radius:16px; padding:24px; text-align:center;
                        box-shadow:0 2px 8px rgba(2,136,209,0.06);">
                        <MudText Style="color:#90A4AE; font-size:13px;">No dismissed students.</MudText>
                    </div>
                }
            }

            @if (_activeTab == 5)
            {
                <MudPaper Class="pa-5 mb-4" Elevation="0" Style="background:#fff;border:1px solid #e5eaf1;border-radius:16px;">
                    <MudText Typo="Typo.h5" Style="font-weight:750;color:#17243a;">Student case review</MudText>
                    <MudText Typo="Typo.body2" Style="color:#718096;margin-bottom:18px;">Review a student's violation history and apply the action recommended by the backend.</MudText>
                    <div style="display:flex;gap:10px;max-width:680px;flex-wrap:wrap;align-items:center;">
                        <MudTextField @bind-Value="_studentLookupNo" Label="Student number" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1;min-width:230px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isLoadingStudent" OnClick="LoadStudentCase" StartIcon="@Icons.Material.Filled.Search">Find student</MudButton>
                    </div>
                </MudPaper>
                @if (_isLoadingStudent) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                else if (_studentReport is not null)
                {
                    <MudGrid Spacing="3" Class="mb-4">
                        <MudItem xs="12" md="8">
                            <MudPaper Class="pa-5" Elevation="0" Style="height:100%;background:#fff;border:1px solid #e5eaf1;border-radius:16px;">
                                <div style="display:flex;justify-content:space-between;gap:16px;align-items:flex-start;">
                                    <div><MudText Typo="Typo.h5" Style="font-weight:750;">@_studentReport.name</MudText><MudText Typo="Typo.body2" Style="color:#718096;">@_studentReport.student_no · @_studentReport.course · Year @_studentReport.year</MudText></div>
                                    <MudChip T="string" Color="@LevelColor(_studentLevel?.ViolationLevel)" Variant="Variant.Filled">@(_studentLevel?.ViolationLevel ?? "Unknown")</MudChip>
                                </div>
                                <MudDivider Class="my-4" />
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Style="color:#718096;">ACTIVE VIOLATIONS</MudText><MudText Typo="Typo.h5" Style="font-weight:750;">@(_studentLevel?.ActiveViolations ?? _studentReport.violation_count)</MudText></MudItem>
                                    <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Style="color:#718096;">RECOMMENDED ACTION</MudText><MudText Typo="Typo.subtitle1" Style="font-weight:700;">@(_studentLevel?.RecommendedAction ?? _studentReport.recommended_action)</MudText></MudItem>
                                    <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Style="color:#718096;">CONTACT</MudText><MudText Typo="Typo.body2">@_studentReport.email</MudText></MudItem>
                                </MudGrid>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700;margin-top:22px;margin-bottom:8px;">Violation history</MudText>
                                @if (_studentReport.violations?.Any() == true)
                                {
                                    <MudTable Items="_studentReport.violations" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                                        <HeaderContent><MudTh>Date</MudTh><MudTh>Violation</MudTh><MudTh>Severity</MudTh><MudTh>Status</MudTh></HeaderContent>
                                        <RowTemplate><MudTd DataLabel="Date">@context.date.ToString("MMM d, yyyy")</MudTd><MudTd DataLabel="Violation"><b>@context.type</b><div><small>@context.details</small></div></MudTd><MudTd DataLabel="Severity">@context.severity</MudTd><MudTd DataLabel="Status">@context.status</MudTd></RowTemplate>
                                    </MudTable>
                                }
                                else { <MudText Typo="Typo.body2" Style="color:#718096;">No violation records found.</MudText> }
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudPaper Class="pa-5" Elevation="0" Style="height:100%;background:#fff;border:1px solid #e5eaf1;border-radius:16px;">
                                <MudText Typo="Typo.h6" Style="font-weight:750;">Available actions</MudText>
                                <MudText Typo="Typo.body2" Style="color:#718096;margin-bottom:18px;">Actions are enabled only when the student's active violation count meets the backend rule.</MudText>
                                <MudButton FullWidth="true" Class="mb-2" Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(_studentLevel?.ActiveViolations != 1 || _studentActionBusy)" OnClick="@(()=>ApplyStudentAction("warn"))">Issue warning · 1 active violation</MudButton>
                                <MudButton FullWidth="true" Class="mb-2" Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(_studentLevel?.ActiveViolations != 2 || _studentActionBusy)" OnClick="@(()=>ApplyStudentAction("counsel"))">Assign counseling · 2 active violations</MudButton>
                                <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Error" Disabled="@((_studentLevel?.ActiveViolations ?? 0) < 3 || _studentActionBusy)" OnClick="@(()=>ApplyStudentAction("recommend-dismiss"))">Recommend dismissal · 3+ active violations</MudButton>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }
            }
            @if (_activeTab == 6)
            {
                <MudPaper Class="pa-5" Elevation="0" Style="background:#fff;border:1px solid #e5eaf1;border-radius:16px;">
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:16px;">
                        <div><MudText Typo="Typo.h5" Style="font-weight:750;color:#17243a;">Audit history</MudText><MudText Typo="Typo.body2" Style="color:#718096;">Recent recorded actions, optionally filtered by student number.</MudText></div>
                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                            <MudTextField @bind-Value="_auditStudentNo" Label="Student number (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isLoadingAudit" OnClick="LoadAuditHistory" StartIcon="@Icons.Material.Filled.Search">Search</MudButton>
                        </div>
                    </div>
                    @if (_isLoadingAudit) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                    else if (_auditEntries?.Any() == true)
                    {
                        <MudTable Items="_auditEntries" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="15">
                            <HeaderContent><MudTh>When</MudTh><MudTh>Action</MudTh><MudTh>Student</MudTh><MudTh>Changed by</MudTh><MudTh>Details</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="When">@context.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</MudTd>
                                <MudTd DataLabel="Action"><b>@context.Action</b></MudTd>
                                <MudTd DataLabel="Student">@(context.StudentNo ?? "—")</MudTd>
                                <MudTd DataLabel="Changed by">@context.ActorUsername <small>(@context.ActorRole)</small></MudTd>
                                <MudTd DataLabel="Details">@(context.Remarks ?? $"{context.PreviousValue ?? "—"} → {context.NewValue ?? "—"}")</MudTd>
                            </RowTemplate>
                            <PagerContent><MudTablePager /></PagerContent>
                        </MudTable>
                    }
                    else { <div style="padding:48px;text-align:center;color:#718096;">No audit records found for this search.</div> }
                </MudPaper>
            }

        </div>
    </MudMainContent>

    @* ── Bottom Nav ── *@
    <div class="sao-navigation">

        <button @onclick="() => SwitchTab(0)" style="@NavBtn(0)">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Style="@NavIcon(0)" />
            <span style="@NavLabel(0)">Overview</span>
        </button>
        <button @onclick="() => SwitchTab(1)" style="@NavBtn(1)">
            <MudIcon Icon="@Icons.Material.Filled.Report" Style="@NavIcon(1)" />
            <span style="@NavLabel(1)">Violations</span>
        </button>
        <button @onclick="() => SwitchTab(2)" style="@NavBtn(2)">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Style="@NavIcon(2)" />
            <span style="@NavLabel(2)">Appeals</span>
        </button>
        <button @onclick="() => SwitchTab(3)" style="@NavBtn(3)">
            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Style="@NavIcon(3)" />
            <span style="@NavLabel(3)">Users</span>
        </button>
        <button @onclick="() => SwitchTab(4)" style="@NavBtn(4)">
            <MudIcon Icon="@Icons.Material.Filled.PersonRemove" Style="@NavIcon(4)" />
            <span style="@NavLabel(4)">Dismiss</span>
        </button>
        <button @onclick="() => SwitchTab(5)" style="@NavBtn(5)">
            <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Style="@NavIcon(5)" />
            <span style="@NavLabel(5)">Students</span>
        </button>
        <button @onclick="() => SwitchTab(6)" style="@NavBtn(6)">
            <MudIcon Icon="@Icons.Material.Filled.History" Style="@NavIcon(6)" />
            <span style="@NavLabel(6)">Audit</span>
        </button>

    </div>

</MudLayout>

