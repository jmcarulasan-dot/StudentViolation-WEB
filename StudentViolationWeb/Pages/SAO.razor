    }

    private void CloseAppealDialog() => _showAppealDialog = false;

    private async Task SubmitAppealReview()
    {
        _isReviewing = true;
        var result = await SaoService.ReviewAppealAsync(
            _reviewingViolationId,
            new AppealReviewRequest { AppealStatus = _appealReviewStatus, AppealRemarks = _appealRemarks });
