                </div>

                @* _model.DateOfBirth is DateTime? — MudDatePicker @bind-Date expects DateTime? *@
                <div style="margin-bottom:16px;">
                    <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Date of birth</MudText>
                    <MudDatePicker @bind-Date="_model.DateOfBirth"
                                   Placeholder="Select date"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                    <div style="margin-bottom:8px;">
                        <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Gender</MudText>
                        <MudSelect T="string"
                                   @bind-Value="_model.Gender"
                                   Placeholder="Select gender"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   FullWidth="true"
                                   Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;">
                            <MudSelectItem Value="@("male")">Male</MudSelectItem>
                            <MudSelectItem Value="@("female")">Female</MudSelectItem>
                        </MudSelect>
                    </div>
                    <div style="margin-bottom:8px;">
                        <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Address</MudText>
                        <MudTextField T="string"
                                      @bind-Value="_model.Address"
                                      Required="true" RequiredError="Required"
                                      Placeholder="Home address"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Outlined.Home"
                                      FullWidth="true"
                                      Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                    </div>
                </div>

                <div style="margin-bottom:16px;">
                    <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Phone number</MudText>
                    <MudTextField T="string"
                                  @bind-Value="_model.Number"
                                  Required="true" RequiredError="Required"
                                  Placeholder="09XXXXXXXXX"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Phone"
                                  FullWidth="true"
                                  Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                </div>

                @* ── Student info ── *@
                @if (_model.Role == "student")
                {
                    <MudText Typo="Typo.overline" Style="color:#8e93a3; letter-spacing:2px; font-size:0.75rem; margin:24px 0 8px; display:block;">Student info</MudText>
                    <MudDivider Style="border-color:rgba(255,255,255,0.15); margin-bottom:16px;" />

                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; margin-bottom:24px;">
                        <div style="margin-bottom:8px;">
                            <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Student no.</MudText>
                            <MudTextField T="string"
                                          @bind-Value="_model.StudentNo"
                                          Required="true" RequiredError="Required"
                                          Placeholder="C26-01-0001-MAN121"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Outlined.Badge"
                                          FullWidth="true"
                                          Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                        </div>
                        <div style="margin-bottom:8px;">
                            <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Course</MudText>
                            <MudSelect T="string"
                                       @bind-Value="_model.Course"
                                       Required="true" RequiredError="Required"
                                       Placeholder="Select course"
                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                       FullWidth="true"
                                       Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;">
                                <MudSelectItem Value="@("BSIT")">BSIT</MudSelectItem>
                                <MudSelectItem Value="@("BSA")">BSA</MudSelectItem>
                                <MudSelectItem Value="@("BSBA")">BSBA</MudSelectItem>
                                <MudSelectItem Value="@("BSCS")">BSCS</MudSelectItem>
                                <MudSelectItem Value="@("BSHM")">BSHM</MudSelectItem>
                            </MudSelect>
                        </div>
                        <div style="margin-bottom:8px;">
                            <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Year level</MudText>
                            <MudSelect T="string"
                                       @bind-Value="_model.Year"
                                       Placeholder="Select year"
                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                       FullWidth="true"
                                       Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;">
                                <MudSelectItem Value="@("1")">1st Year</MudSelectItem>
                                <MudSelectItem Value="@("2")">2nd Year</MudSelectItem>
                                <MudSelectItem Value="@("3")">3rd Year</MudSelectItem>
                                <MudSelectItem Value="@("4")">4th Year</MudSelectItem>
                            </MudSelect>
                        </div>
                    </div>
                }

            </MudForm>

            <MudButton Variant="Variant.Filled" FullWidth="true" Size="Size.Large"
                       OnClick="HandleRegister"
                       Disabled="@(!_isValid || _isLoading || string.IsNullOrEmpty(_model.Role))"
                       Style="background:linear-gradient(90deg,#a6e8d8,#7fd6c2); color:#0e1017; font-weight:700; font-size:0.98rem; border-radius:10px; padding:13px 16px; text-transform:none; margin-top:8px; box-shadow:0 8px 24px rgba(166,232,216,0.22);">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="margin-right:8px;" />
                    <span>Submitting request...</span>
                }
                else
                {
                    <span>Submit for Admission approval</span>
                }
            </MudButton>

            <p style="text-align:center; font-size:0.9rem; color:rgba(255,255,255,0.6); margin:24px 0 0;">
                Already have an account?
                <MudLink Href="/login"
                         Style="color:#a6e8d8; font-weight:700; margin-left:4px; text-decoration:none;">Sign in</MudLink>
            </p>
        </div>
    </div>

    @* ── Right: picture panel ── *@
    <div style="flex:1; display:flex; flex-direction:column; justify-content:center; padding:56px; overflow:hidden;
                background:linear-gradient(180deg,rgba(14,16,23,0.55) 0%,rgba(14,16,23,0.82) 100%),
                           radial-gradient(circle at 70% 20%,#1d3b3a 0%,#0e1017 65%);
                border-left:1px solid rgba(255,255,255,0.09);">

        <div style="position:absolute; top:48px; left:56px; display:inline-flex; align-items:center; gap:8px;
                    padding:8px 16px; border-radius:999px; font-size:0.85rem; color:#f2f4f8;
                    background:rgba(21,24,33,0.7); border:1px solid rgba(255,255,255,0.18); backdrop-filter:blur(8px);">
            <MudIcon Icon="@Icons.Material.Filled.Bolt" Style="color:#a6e8d8; font-size:1.1rem;" />
            <span>Student Affairs Office</span>
        </div>

        <MudText Typo="Typo.h3"
                 Style="color:#f2f4f8; font-weight:700; line-height:1.12; margin:0 0 18px;">
            One request,
            <span style="color:#a6e8d8; display:block;">reviewed by Admissions.</span>
        </MudText>
        <MudText Typo="Typo.body1"
                 Style="color:rgba(242,244,248,0.82); line-height:1.6; margin:0 0 32px; max-width:460px;">
            Fill in your details once. You can sign in as soon as your account is approved.
        </MudText>

        <div style="display:flex; align-items:center; gap:16px; max-width:440px; padding:16px 18px; margin-bottom:14px;
                    border-radius:14px; background:rgba(21,24,33,0.62); border:1px solid rgba(255,255,255,0.09); backdrop-filter:blur(10px);">
            <div style="width:44px; height:44px; border-radius:12px; display:grid; place-items:center;
                        background:rgba(166,232,216,0.14); color:#a6e8d8; flex-shrink:0;">
                <MudIcon Icon="@Icons.Material.Filled.HowToReg" />
            </div>
            <div>
                <b style="color:#f2f4f8;">Admission approval</b>
                <div style="color:#8e93a3; font-size:0.85rem;">Every student account is verified</div>
            </div>
        </div>
        <div style="display:flex; align-items:center; gap:16px; max-width:440px; padding:16px 18px; margin-bottom:14px;
                    border-radius:14px; background:rgba(21,24,33,0.62); border:1px solid rgba(255,255,255,0.09); backdrop-filter:blur(10px);">
            <div style="width:44px; height:44px; border-radius:12px; display:grid; place-items:center;
                        background:rgba(166,232,216,0.14); color:#a6e8d8; flex-shrink:0;">
                <MudIcon Icon="@Icons.Material.Filled.Shield" />
            </div>
            <div>
                <b style="color:#f2f4f8;">Secure access</b>
                <div style="color:#8e93a3; font-size:0.85rem;">Sign-in protected by an authenticator code</div>
            </div>
        </div>
    </div>
</div>

@code {
    private MudForm _form = default!;
    private bool _isValid;
    private bool _isLoading;
    private InputType _pwdType = InputType.Password;
    private string _pwdIcon = Icons.Material.Filled.VisibilityOff;

    // DateOfBirth is DateTime? — MudDatePicker @bind-Date needs exactly this
    private RegisterModel _model = new() { Role = "student" };

    // Role card data — avoids repetitive markup
    private record RoleItem(string Key, string Label, string Icon);
    private readonly List<RoleItem> _roleOptions =
    [
        new("student",  "Student",  Icons.Material.Filled.School),
        new("guard",    "Guard",    Icons.Material.Filled.Security),
        new("sao",      "SAO",      Icons.Material.Filled.AdminPanelSettings),
        new("guidance", "Guidance", Icons.Material.Filled.SupervisorAccount),
    ];

    private void TogglePassword()
    {
        (_pwdType, _pwdIcon) = _pwdType == InputType.Password
            ? (InputType.Text, Icons.Material.Filled.Visibility)
            : (InputType.Password, Icons.Material.Filled.VisibilityOff);
    }

    private async Task HandleRegister()
    {
        await _form.Validate();
        if (!_isValid) return;

        if (string.IsNullOrEmpty(_model.Role))
        {
            Snackbar.Add("Please select a role.", Severity.Warning);
            return;
        }
        if (_model.DateOfBirth == null)
        {
            Snackbar.Add("Please select your date of birth.", Severity.Warning);
            return;
        }
        if (_model.DateOfBirth.Value.Date > DateTime.Today)
        {
            Snackbar.Add("Date of birth cannot be in the future.", Severity.Warning);
            return;
        }

        _isLoading = true;
        try
        {
            // AuthService converts DateTime? → "yyyy-MM-dd" string before posting
            var result = await AuthService.RegisterAsync(_model);
            if (result?.Status == 200)
            {
                Snackbar.Add("Request submitted. You can sign in after Admissions approves it.", Severity.Success);
                Nav.NavigateTo("/login");
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Registration failed.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Connection error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static int CalculateAge(DateTime dateOfBirth)
    {
        var today = DateTime.Today;
        var age = today.Year - dateOfBirth.Year;
        if (dateOfBirth.Date > today.AddYears(-age)) age--;
        return age;
    }

    // ── Style helpers for role cards ─────────────────────────────────────────
    private static string RoleCardStyle(bool active) =>
        $"display:flex; flex-direction:column; align-items:center; justify-content:center; " +
        $"padding:20px 12px; border-radius:12px; cursor:pointer; " +
        $"border:2px solid {(active ? "white" : "rgba(255,255,255,0.15)")}; " +
        $"background:{(active ? "rgba(255,255,255,0.15)" : "rgba(255,255,255,0.05)")};";

    private static string RoleIconStyle(bool active) =>
        $"font-size:32px; margin-bottom:8px; color:{(active ? "white" : "rgba(255,255,255,0.5)")};";

    private static string RoleLabelStyle(bool active) =>
        $"font-size:0.8rem; font-weight:{(active ? "700" : "400")}; " +
        $"color:{(active ? "white" : "rgba(255,255,255,0.6)")};";
}
