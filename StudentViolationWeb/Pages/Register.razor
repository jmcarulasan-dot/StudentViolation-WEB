@page "/register"
@using StudentViolationWeb.Data
@using StudentViolationWeb.Model
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AuthService AuthService

<div style="display:flex; height:100vh; width:100%; font-family:'Segoe UI',system-ui,sans-serif;
            background:linear-gradient(135deg, #0e1017 0%, #151821 100%); color:#f2f4f8;">

    @* ── Left: form ── *@
