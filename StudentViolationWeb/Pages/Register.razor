        <div style="width:100%; max-width:720px;
                    background:rgba(21,24,33,0.7);
                    border:1px solid rgba(255,255,255,0.09);
                    border-radius:20px; padding:48px 40px;
                    box-shadow:0 8px 32px rgba(0,0,0,0.45);">

            <MudText Typo="Typo.h4" Style="color:#f2f4f8; font-weight:700; margin-bottom:8px;">
                Create account
            </MudText>
            <MudText Style="color:rgba(255,255,255,0.5); margin-bottom:24px;">
                Submit your student account request. Admissions must approve it before you can sign in.
            </MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid">

                @* ── Account info ── *@
                <MudText Typo="Typo.overline" Style="color:#8e93a3; letter-spacing:2px; font-size:0.75rem; margin-bottom:8px; display:block;">Account info</MudText>
                <MudDivider Style="border-color:rgba(255,255,255,0.15); margin-bottom:16px;" />

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                    <div style="margin-bottom:8px;">
                        <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Username</MudText>
                        <MudTextField T="string" Label="Username"
                                      @bind-Value="_model.Username"
                                      Required="true" RequiredError="Required"
                                      Placeholder="Choose a username"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Outlined.Person"
                                      FullWidth="true"
                                      Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                    </div>
                    <div style="margin-bottom:8px;">
                        <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Email</MudText>
                        <MudTextField T="string" Label="Email"
                                      @bind-Value="_model.Email"
                                      Required="true" RequiredError="Required"
                                      InputType="InputType.Email"
                                      Placeholder="you@example.com"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Outlined.Email"
                                      FullWidth="true"
                                      Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                    </div>
                </div>

                <div style="margin-bottom:16px;">
                    <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Password</MudText>
                    <MudTextField T="string" Label="Password"
                                  @bind-Value="_model.Password"
                                  Required="true" RequiredError="Required"
                                  Placeholder="Create a password"
                                  InputType="@_pwdType"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_pwdIcon"
                                  OnAdornmentClick="TogglePassword"
                                  FullWidth="true"
                                  Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                </div>

                @* ── Personal info ── *@
                <MudText Typo="Typo.overline" Style="color:#8e93a3; letter-spacing:2px; font-size:0.75rem; margin:24px 0 8px; display:block;">Personal info</MudText>
                <MudDivider Style="border-color:rgba(255,255,255,0.15); margin-bottom:16px;" />

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">

                    <div style="margin-bottom:8px;">
                        <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">First name</MudText>
                        <MudTextField T="string"
                                      @bind-Value="_model.FirstName"
                                      Required="true" RequiredError="Required"
                                      Placeholder="First name"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      FullWidth="true"
                                      Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
                    </div>
                    <div style="margin-bottom:8px;">
                        <MudText Style="display:block; font-size:0.85rem; font-weight:600; color:#f2f4f8; margin-bottom:6px;">Last name</MudText>
                        <MudTextField T="string"
                                      @bind-Value="_model.LastName"
                                      Required="true" RequiredError="Required"
                                      Placeholder="Last name"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      FullWidth="true"
                                      Style="--mud-paper-filled-bg:#1b1e29; color:#f2f4f8;" />
