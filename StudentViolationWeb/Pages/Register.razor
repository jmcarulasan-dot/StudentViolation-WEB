@page "/register"
@using StudentViolationWeb.Data
@using StudentViolationWeb.Model
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AuthService AuthService

<div style="display:flex; height:100vh; width:100%; font-family:'Segoe UI',sans-serif;
            background-image:linear-gradient(135deg, #0057B8 0%, #F9FAFB 100%);">

    @* ── Left Panel ── *@
    <div style="width:45%; display:flex; flex-direction:column; align-items:center;
                justify-content:center; padding:60px 80px; flex-shrink:0;">
        <img src="Image/aclc_logo.png" alt="ACLC Logo" style="width:120px; height:auto;" />
        <MudText Typo="Typo.h6" Align="Align.Center"
                 Style="color:#EEEEEE; font-weight:500; margin-bottom:8px;
                        letter-spacing:2px; text-transform:uppercase;">
            ACLC College of Mandaue
        </MudText>
        <MudText Typo="Typo.h3" Align="Align.Center"
                 Style="color:#EEEEEE; font-weight:800; margin-bottom:20px; line-height:1.2;">
            Student Violation System
        </MudText>
    </div>

    @* ── Right Panel ── *@
    <div style="flex:1; overflow-y:auto; padding:60px 80px;">
        <div style="width:100%; max-width:720px;
                    background:rgba(0,87,184,0.10);
                    backdrop-filter:blur(12px);
                    -webkit-backdrop-filter:blur(12px);
                    border:1px solid rgba(17,24,39,0.15);
                    border-radius:20px; padding:48px 40px;
                    box-shadow:0 8px 32px rgba(250,250,250,0.15);">

            <MudText Typo="Typo.h4" Style="color:#FAFAFA; font-weight:700; margin-bottom:8px;">
                Create Account
            </MudText>
            <MudText Style="color:rgba(255,255,255,0.5); margin-bottom:40px;">
                Fill in the details below to register your account.
            </MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid">

                @* ── Select Role ── *@
                <MudText Typo="Typo.overline" Style="color:#FAFAFA; letter-spacing:2px;">Select Role</MudText>
                <MudDivider Style="border-color:rgba(255,255,255,0.15); margin-bottom:20px;" />

                <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:12px; margin-bottom:36px;">
                    @foreach (var item in _roleOptions)
                    {
                        bool active = _model.Role == item.Key;
                        <div @onclick="@(() => _model.Role = item.Key)"
                             style="@RoleCardStyle(active)">
                            <MudIcon Icon="@item.Icon" Style="@RoleIconStyle(active)" />
                            <MudText Style="@RoleLabelStyle(active)">@item.Label</MudText>
                        </div>
                    }
                </div>

                @* ── Account Info ── *@
                <MudText Typo="Typo.overline" Style="color:#FAFAFA; letter-spacing:2px;">Account Info</MudText>
                <MudDivider Style="border-color:rgba(255,255,255,0.15); margin-bottom:20px;" />

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                    <MudTextField T="string" Label="Username"
                                  @bind-Value="_model.Username"
                                  Required="true" RequiredError="Required"
                                  Variant="Variant.Outlined"
                                  InputStyle="color:white;" Style="color:#FAFAFA;" />
                    <MudTextField T="string" Label="Email"
                                  @bind-Value="_model.Email"
                                  Required="true" RequiredError="Required"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined"
                                  InputStyle="color:white;" Style="color:#FAFAFA;" />
                </div>

                <MudTextField T="string" Label="Password"
                              @bind-Value="_model.Password"
                              Required="true" RequiredError="Required"
                              InputType="@_pwdType"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_pwdIcon"
                              OnAdornmentClick="TogglePassword"
                              Class="mb-8"
                              InputStyle="color:white;" Style="color:#FAFAFA;" />

                @* ── Personal Info ── *@
                <MudText Typo="Typo.overline" Style="color:#FAFAFA; letter-spacing:2px;">Personal Info</MudText>
                <MudDivider Style="border-color:rgba(255,255,255,0.15); margin-bottom:20px;" />

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                    <MudTextField T="string" Label="First Name"
                                  @bind-Value="_model.FirstName"
                                  Required="true" RequiredError="Required"
                                  Variant="Variant.Outlined"
                                  InputStyle="color:white;" Style="color:#FAFAFA;" />
                    <MudTextField T="string" Label="Last Name"
                                  @bind-Value="_model.LastName"
                                  Required="true" RequiredError="Required"
                                  Variant="Variant.Outlined"
                                  InputStyle="color:white;" Style="color:#FAFAFA;" />

                    @* _model.DateOfBirth is DateTime? — MudDatePicker @bind-Date expects DateTime?
                       This is the only correct binding. No string, no conversion here. *@
                    <MudDatePicker Label="Date of Birth"
                                   @bind-Date="_model.DateOfBirth"
                                   Variant="Variant.Outlined"
                                   InputStyle="color:white;" />

                    <MudSelect T="string" Label="Gender"
                               @bind-Value="_model.Gender"
                               Variant="Variant.Outlined"
                               Style="color:#FAFAFA;" InputStyle="color:white;">
                        <MudSelectItem Value="@("male")">Male</MudSelectItem>
                        <MudSelectItem Value="@("female")">Female</MudSelectItem>
                    </MudSelect>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:36px;">
                    <MudTextField T="string" Label="Address"
                                  @bind-Value="_model.Address"
                                  Required="true" RequiredError="Required"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Home"
                                  InputStyle="color:white;" Style="color:#FAFAFA;" />
                    <MudTextField T="string" Label="Phone Number (09XXXXXXXXX)"
                                  @bind-Value="_model.Number"
                                  Required="true" RequiredError="Required"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Phone"
                                  InputStyle="color:white;" Style="color:#FAFAFA;" />
                </div>

                @* ── Student Info ── *@
                @if (_model.Role == "student")
                {
                    <MudText Typo="Typo.overline" Style="color:#FAFAFA; letter-spacing:2px;">Student Info</MudText>
                    <MudDivider Style="border-color:rgba(255,255,255,0.15); margin-bottom:20px;" />

                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; margin-bottom:36px;">
                        <MudTextField T="string" Label="Student No. (C26-01-0001-MAN121)"
                                      @bind-Value="_model.StudentNo"
                                      Required="true" RequiredError="Required"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge"
                                      InputStyle="color:white;" Style="color:#FAFAFA;" />
                        <MudSelect T="string" Label="Course"
                                   @bind-Value="_model.Course"
                                   Required="true" RequiredError="Required"
                                   Variant="Variant.Outlined"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.MenuBook"
                                   InputStyle="color:white;" Style="color:#FAFAFA;">
                            <MudSelectItem Value="@("BSIT")">BSIT</MudSelectItem>
                            <MudSelectItem Value="@("BSHM")">BSHM</MudSelectItem>
                            <MudSelectItem Value="@("BSBA")">BSBA</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Label="Year Level"
                                   @bind-Value="_model.Year"
                                   Variant="Variant.Outlined"
                                   Style="color:#FAFAFA;" InputStyle="color:white;">
                            <MudSelectItem Value="@("1")">1st Year</MudSelectItem>
                            <MudSelectItem Value="@("2")">2nd Year</MudSelectItem>
                            <MudSelectItem Value="@("3")">3rd Year</MudSelectItem>
                            <MudSelectItem Value="@("4")">4th Year</MudSelectItem>
                        </MudSelect>
                    </div>
                }

            </MudForm>

            <MudButton Variant="Variant.Filled" FullWidth="true" Size="Size.Large"
                       OnClick="HandleRegister"
                       Disabled="@(!_isValid || _isLoading || string.IsNullOrEmpty(_model.Role))"
                       Style="background:#111827; color:white; font-weight:700;
                              font-size:1rem; border-radius:8px; padding:16px;
                              text-transform:none; margin-bottom:20px;">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="margin-right:8px;" />
                    <span>Creating Account...</span>
                }
                else
                {
                    <span>Create Account</span>
                }
            </MudButton>

            <MudText Align="Align.Center" Style="color:#F9FAFB; font-size:0.9rem; padding-bottom:40px;">
                Already have an account?
                <MudLink Href="/login" Color="Color.Inherit"
                         Style="color:#F9FAFB; font-weight:700; margin-left:4px;">
                    Sign In
                </MudLink>
            </MudText>
        </div>
    </div>
</div>

@code {
    private MudForm _form = default!;
    private bool _isValid;
    private bool _isLoading;
    private InputType _pwdType = InputType.Password;
    private string _pwdIcon = Icons.Material.Filled.VisibilityOff;

    // DateOfBirth is DateTime? — MudDatePicker @bind-Date needs exactly this
    private RegisterModel _model = new();

    // Role card data — avoids repetitive markup
    private record RoleItem(string Key, string Label, string Icon);
    private readonly List<RoleItem> _roleOptions =
    [
        new("student",  "Student",  Icons.Material.Filled.School),
        new("guard",    "Guard",    Icons.Material.Filled.Security),
        new("sao",      "SAO",      Icons.Material.Filled.AdminPanelSettings),
        new("guidance", "Guidance", Icons.Material.Filled.SupervisorAccount),
    ];

    private void TogglePassword()
    {
        (_pwdType, _pwdIcon) = _pwdType == InputType.Password
            ? (InputType.Text, Icons.Material.Filled.Visibility)
            : (InputType.Password, Icons.Material.Filled.VisibilityOff);
    }

    private async Task HandleRegister()
    {
        await _form.Validate();
        if (!_isValid) return;

        if (string.IsNullOrEmpty(_model.Role))
        {
            Snackbar.Add("Please select a role.", Severity.Warning);
            return;
        }
        if (_model.DateOfBirth == null)
        {
            Snackbar.Add("Please select your date of birth.", Severity.Warning);
            return;
        }

        _isLoading = true;
        try
        {
            // AuthService converts DateTime? → "yyyy-MM-dd" string before posting
            var result = await AuthService.RegisterAsync(_model);
            if (result?.Status == 200)
            {
                Snackbar.Add("Account created successfully!", Severity.Success);
                Nav.NavigateTo("/login");
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Registration failed.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Connection error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ── Style helpers for role cards ─────────────────────────────────────────
    private static string RoleCardStyle(bool active) =>
        $"display:flex; flex-direction:column; align-items:center; justify-content:center; " +
        $"padding:20px 12px; border-radius:12px; cursor:pointer; " +
        $"border:2px solid {(active ? "white" : "rgba(255,255,255,0.15)")}; " +
        $"background:{(active ? "rgba(255,255,255,0.15)" : "rgba(255,255,255,0.05)")};";

    private static string RoleIconStyle(bool active) =>
        $"font-size:32px; margin-bottom:8px; color:{(active ? "white" : "rgba(255,255,255,0.5)")};";

    private static string RoleLabelStyle(bool active) =>
        $"font-size:0.8rem; font-weight:{(active ? "700" : "400")}; " +
        $"color:{(active ? "white" : "rgba(255,255,255,0.6)")};";
}
