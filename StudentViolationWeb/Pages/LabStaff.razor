@page "/lab-staff"
@inject LabPcService LabPcService
@inject IDialogService DialogService
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Lab Staff · SVS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudStack Spacing="1" Class="mb-5">
        <MudText Typo="Typo.h4">Computer Lab</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">Manage lab PCs, issue student vouchers, and monitor timed sessions.</MudText>
    </MudStack>

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!authorized)
    {
        <MudAlert Severity="Severity.Error">This page is for Lab Staff accounts only.</MudAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
        }
        @if (enrollmentCode is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => enrollmentCode = null">
                <b>Show this one-time PC enrollment code to the lab technician now:</b>
                <MudTextField Value="@enrollmentCode" ReadOnly="true" Variant="Variant.Outlined" />
                It will not be displayed again.
            </MudAlert>
        }
        @if (voucherCode is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => voucherCode = null">
                <b>One-time student voucher</b>
                <MudTextField Value="@voucherCode" ReadOnly="true" Variant="Variant.Outlined" />
                Share it with the selected student through the school-approved channel. It is not stored for later viewing.
            </MudAlert>
        }

        <MudGrid Class="mb-4">
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">Register lab PC</MudText>
                    <MudTextField @bind-Value="computerName" Label="Computer name" Required="true" />
                    <MudTextField @bind-Value="location" Label="Location" Required="true" Class="mt-2" />
                    <MudButton OnClick="CreateComputer" Disabled="busy" Color="Color.Primary" Variant="Variant.Filled" Class="mt-3">Register PC</MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">Issue student voucher</MudText>
                    <MudTextField @bind-Value="studentNo" Label="Student number" Required="true" />
                    <MudNumericField @bind-Value="durationMinutes" Label="Session length (minutes)" Min="15" Max="240" />
                    <MudButton OnClick="CreateVoucher" Disabled="busy" Color="Color.Primary" Variant="Variant.Filled" Class="mt-3">Issue voucher</MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6">Session policy</MudText>
                    <MudText Typo="Typo.body2">Sessions run for the selected duration (15–240 minutes). The kiosk ends access when the server session expires.</MudText>
                    <MudButton OnClick="Refresh" Disabled="busy" Variant="Variant.Outlined" Class="mt-3">Refresh status</MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">Lab PCs</MudText>
            <MudTable Items="computers" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Computer</MudTh><MudTh>Location</MudTh><MudTh>Status</MudTh><MudTh>Last contact (UTC)</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Computer">@context.ComputerName</MudTd>
                    <MudTd DataLabel="Location">@context.Location</MudTd>
                    <MudTd DataLabel="Status"><MudChip Color="@(context.Enabled && context.IsOnline ? Color.Success : Color.Warning)" Size="Size.Small">@(context.Enabled ? (context.IsOnline ? "Online" : "Offline") : "Disabled")</MudChip></MudTd>
                    <MudTd DataLabel="Last contact">@(context.LastHeartbeatUtc?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</MudTd>
                    <MudTd><MudButton Size="Size.Small" Color="Color.Error" Disabled="@(!context.Enabled || busy)" OnClick="@(() => DisableComputer(context.ComputerId))">Disable</MudButton></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>No lab PCs registered yet.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">Active sessions</MudText>
            <MudTable Items="sessions" Dense="true" Hover="true">
                <HeaderContent><MudTh>Student</MudTh><MudTh>PC</MudTh><MudTh>Started (UTC)</MudTh><MudTh>Expires (UTC)</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Student">@context.StudentName (@context.StudentNo)</MudTd>
                    <MudTd DataLabel="PC">@context.ComputerName</MudTd>
                    <MudTd DataLabel="Started">@context.StartedAtUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd DataLabel="Expires">@context.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd><MudButton Size="Size.Small" Color="Color.Error" Disabled="busy" OnClick="@(() => EndSession(context.SessionId))">End session</MudButton></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>No active sessions.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">Voucher history</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudTextField @bind-Value="voucherFilter" Label="Filter by student number" />
                <MudButton OnClick="LoadVouchers" Variant="Variant.Outlined">Search</MudButton>
            </MudStack>
            <MudTable Items="vouchers" Dense="true" Hover="true">
                <HeaderContent><MudTh>Student</MudTh><MudTh>Status</MudTh><MudTh>Duration</MudTh><MudTh>Issued</MudTh><MudTh>Expires</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Student">@context.StudentName (@context.StudentNo)</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                    <MudTd DataLabel="Duration">@context.DurationMinutes min</MudTd>
                    <MudTd DataLabel="Issued">@context.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd DataLabel="Expires">@context.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd><MudButton Size="Size.Small" Disabled="@(busy || context.Status != "Unused")" OnClick="@(() => RevokeVoucher(context.VoucherId))">Revoke</MudButton></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>No vouchers found.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</MudContainer>

@code {
    bool loading = true;
    bool authorized;
    bool busy;
    string? error;
    string? enrollmentCode;
    string? voucherCode;
    string computerName = "";
    string location = "";
    string studentNo = "";
    string voucherFilter = "";
    int durationMinutes = 60;
    List<LabPcComputer> computers = new();
    List<LabPcVoucher> vouchers = new();
    List<LabPcSession> sessions = new();

    protected override async Task OnInitializedAsync()
    {
        var role = await LocalStorage.GetItemAsync<string>("authRole");
        authorized = string.Equals(role, "LabStaff", StringComparison.Ordinal);
        if (authorized) await Refresh();
        loading = false;
    }

    async Task Refresh()
    {
        busy = true;
        error = null;
        try
        {
            computers = await LabPcService.GetComputers();
            sessions = await LabPcService.GetSessions();
            vouchers = await LabPcService.GetVouchers(voucherFilter);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; loading = false; }
    }

    async Task LoadVouchers()
    {
        try { vouchers = await LabPcService.GetVouchers(voucherFilter); error = null; }
        catch (Exception ex) { error = ex.Message; }
    }

    async Task CreateComputer()
    {
        busy = true; error = null;
        try
        {
            var result = await LabPcService.CreateComputer(computerName.Trim(), location.Trim());
            enrollmentCode = result.EnrollmentCode;
            computerName = ""; location = "";
            await Refresh();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    async Task CreateVoucher()
    {
        busy = true; error = null;
        try
        {
            var result = await LabPcService.CreateVoucher(studentNo.Trim(), durationMinutes);
            voucherCode = result.VoucherCode;
            studentNo = "";
            await LoadVouchers();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    async Task DisableComputer(int id)
    {
        if (!await Confirm("Disable this PC?")) return;
        busy = true;
        try { await LabPcService.DisableComputer(id); await Refresh(); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    async Task RevokeVoucher(long id)
    {
        if (!await Confirm("Revoke this unused voucher?")) return;
        busy = true;
        try { await LabPcService.RevokeVoucher(id); await LoadVouchers(); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    async Task EndSession(Guid id)
    {
        if (!await Confirm("End this lab session now?")) return;
        busy = true;
        try { await LabPcService.EndSession(id); await Refresh(); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    async Task<bool> Confirm(string message)
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowMessageBox("Please confirm", message, yesText: "Confirm", cancelText: "Cancel", options: options);
        return dialog == true;
    }
}