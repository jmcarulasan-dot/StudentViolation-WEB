@page "/guidance/"
@inject NavigationManager Nav
@inject AuthService AuthService
@inject GuidanceService GuidanceService
@inject ISnackbar Snackbar

<PageTitle>Guidance Dashboard</PageTitle>o3

<MudLayout>

    @* ── Top Bar ── *@
    <MudAppBar Elevation="0"
               Style="background:rgba(255,255,255,0.95);
                      backdrop-filter:blur(20px);
                      border-bottom:1px solid #EDE7F6;">
        <MudSpacer />
        <MudText Typo="Typo.h6"
                 Style="font-weight:700; color:#6A1B9A; letter-spacing:0.02em;">
            Guidance Dashboard
        </MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       OnClick="Logout"
                       Style="color:#546E7A;" />
    </MudAppBar>

    <MudMainContent Style="background:#F3E5F5; min-height:100vh; padding-bottom:80px;">

        <div style="position:fixed; inset:0;
                    background:radial-gradient(ellipse 60% 50% at 0% 0%, #EDE7F6 0%, transparent 60%),
                               radial-gradient(ellipse 40% 40% at 100% 100%, #D1C4E9 0%, transparent 60%);
                    pointer-events:none; z-index:0;"></div>

        <div style="position:relative; z-index:1; padding:16px 16px 0;">

            @* ══════════ TAB 0 — STUDENTS ══════════ *@
            @if (_activeTab == 0)
            {
                <div style="background:linear-gradient(135deg,#FFFFFF,#EDE7F6);
                                    border:1px solid #D1C4E9; border-radius:16px;
                                    padding:16px 20px; margin-bottom:18px;
                                    display:flex; align-items:center; gap:16px;
                                    box-shadow:0 4px 12px rgba(106,27,154,0.08);">
                    <div style="width:44px; height:44px; border-radius:12px;
                                        background:#6A1B9A;
                                        display:flex; align-items:center; justify-content:center;
                                        flex-shrink:0; box-shadow:0 4px 8px rgba(106,27,154,0.25);">
                        <MudIcon Icon="@Icons.Material.Filled.People" Style="color:#FFFFFF; font-size:22px;" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#6A1B9A; font-size:14px;">
                            Students Overview
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#546E7A; font-size:11px;">
                            All registered students with violation status
                        </MudText>
                    </div>
                </div>

                <MudTextField @bind-Value="_studentSearch"
                              Placeholder="Search by name or student no..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Style="margin-bottom:12px; background:#FFFFFF; border-radius:12px;" />

                @if (_isLoadingStudents)
                {
                    <div style="text-align:center; padding:40px;">
                        <MudProgressCircular Indeterminate="true" Style="color:#6A1B9A;" />
                    </div>
                }
                else
                {
                    <div style="background:#FFFFFF; border:1px solid #EDE7F6;
                                                border-radius:16px; overflow:hidden;
                                                box-shadow:0 2px 10px rgba(106,27,154,0.06);">
                        @{
                            var filtered = _students?
                            .Where(s =>
                            string.IsNullOrEmpty(_studentSearch) ||
                            (s.name?.Contains(_studentSearch, StringComparison.OrdinalIgnoreCase) == true) ||
                            (s.student_no?.Contains(_studentSearch, StringComparison.OrdinalIgnoreCase) == true))
                            .ToList();
                        }

                        @if (filtered?.Any() == true)
                        {
                            @foreach (var s in filtered)
                            {
                                <div style="padding:14px 18px; border-bottom:1px solid #F3E5F5;">
                                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
                                        <div style="width:38px; height:38px; border-radius:50%;
                                                                                    background:linear-gradient(135deg,#EDE7F6,#D1C4E9);
                                                                                    border:1px solid #CE93D8;
                                                                                    display:flex; align-items:center; justify-content:center;
                                                                                    font-size:14px; font-weight:700; color:#6A1B9A;
                                                                                    flex-shrink:0;">
                                            @(s.name?.Substring(0, 1).ToUpper() ?? "S")
                                        </div>
                                        <div style="flex:1; min-width:0;">
                                            <MudText Style="font-size:13px; font-weight:600; color:#1A237E;
                                                                                           white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                                @s.name
                                            </MudText>
                                            <MudText Style="font-size:11px; color:#90A4AE;">
                                                @s.student_no
                                            </MudText>
                                        </div>
                                        <div style="background:@GetWarningBg(s.warning_level);
                                                                                    border:1px solid @GetWarningBorderColor(s.warning_level);
                                                                                    border-radius:20px; padding:3px 10px;">
                                            <MudText Style="@($"font-size:10px; font-weight:700; color:{GetWarningColor(s.warning_level)};")">
                                                @s.warning_level?.ToUpper()
                                            </MudText>
                                        </div>
                                    </div>

                                    @* Violations count + recommended action *@
                                    <div style="margin-left:50px; display:flex; align-items:center;
                                                                                gap:8px; flex-wrap:wrap;">
                                        <span style="font-size:11px; color:#546E7A;">
                                            <strong>@s.violation_count</strong> violation@(s.violation_count != 1 ? "s" : "")
                                        </span>
                                        @if (!string.IsNullOrEmpty(s.recommended_action) && s.recommended_action != "No action needed")
                                        {
                                            <span style="font-size:10px; color:#F9A825; font-weight:600;">
                                                · @s.recommended_action
                                            </span>
                                        }
                                    </div>

                                    @* Action buttons *@
                                    <div style="margin-left:50px; margin-top:8px; display:flex; gap:8px; flex-wrap:wrap;">
                                        <MudButton Variant="Variant.Outlined"
                                                   Size="Size.Small"
                                                   OnClick="() => ViewStudentReport(s.student_no!)"
                                                   Style="font-size:10px; height:26px; border-color:#6A1B9A; color:#6A1B9A; text-transform:none;">
                                            View Report
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined"
                                                   Size="Size.Small"
                                                   OnClick="() => WarnStudent(s.student_no!)"
                                                   Style="font-size:10px; height:26px; border-color:#F9A825; color:#F9A825; text-transform:none;">
                                            Warn
                                        </MudButton>
                                        @if (s.violation_count >= 3)
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Size="Size.Small"
                                                       OnClick="() => RecommendDismissal(s.student_no!)"
                                                       Style="font-size:10px; height:26px; border-color:#E53935; color:#E53935; text-transform:none;">
                                                Recommend Dismissal
                                            </MudButton>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="padding:40px; text-align:center;">
                                <MudText Style="color:#90A4AE;">No students found.</MudText>
                            </div>
                        }
                    </div>
                }
            }

            @* ══════════ TAB 1 — VIOLATIONS ══════════ *@
            @if (_activeTab == 1)
            {
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
                    <div style="width:4px; height:20px; background:#6A1B9A; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.ListAlt" Style="color:#6A1B9A; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        Violations by Status
                    </MudText>
                </div>

                @if (_isLoadingViolations)
                {
                    <div style="text-align:center; padding:40px;">
                        <MudProgressCircular Indeterminate="true" Style="color:#6A1B9A;" />
                    </div>
                }
                else if (_violationsByStatus != null)
                {
                    @foreach (var group in _violationsByStatus)
                    {
                        <div style="background:#FFFFFF; border:1px solid #EDE7F6;
                                                            border-radius:14px; margin-bottom:14px; overflow:hidden;
                                                            box-shadow:0 2px 8px rgba(106,27,154,0.06);">
                            <div style="padding:12px 18px; background:@GetStatusBg(group.status);
                                                                border-bottom:1px solid #EDE7F6;
                                                                display:flex; align-items:center; gap:10px;">
                                <span style="@StatusBadge(group.status)">@group.status</span>
                                <MudText Style="font-size:12px; color:#546E7A;">
                                    @group.count violation@(group.count != 1 ? "s" : "")
                                </MudText>
                            </div>

                            @if (group.violations?.Any() == true)
                            {
                                @foreach (var v in group.violations)
                                {
                                    <div style="padding:12px 18px; border-bottom:1px solid #F8F0FF;">
                                        <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
                                            <MudText Style="font-size:12px; font-weight:600; color:#1A237E; flex:1;">
                                                @v.type
                                            </MudText>
                                            <span style="@SeverityBadge(v.severity)">@v.severity</span>
                                        </div>
                                        <MudText Style="font-size:11px; color:#90A4AE;">
                                            @v.student_no  ·  @v.date.ToString("MMM dd, yyyy")  ·  By: @v.recorded_by
                                        </MudText>
                                        @if (!string.IsNullOrEmpty(v.details))
                                        {
                                            <MudText Style="font-size:11px; color:#607D8B; margin-top:2px;">
                                                @v.details
                                            </MudText>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div style="padding:16px 18px; text-align:center;">
                                    <MudText Style="font-size:12px; color:#90A4AE;">No @(group.status?.ToLower()) violations.</MudText>
                                </div>
                            }
                        </div>
                    }
                }
            }

            @* ══════════ TAB 2 — APPEALS ══════════ *@
            @if (_activeTab == 2)
            {
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
                    <div style="width:4px; height:20px; background:#E65100; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.Gavel" Style="color:#E65100; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        Pending Appeals
                    </MudText>
                </div>

                @if (_isLoadingAppeals)
                {
                    <div style="text-align:center; padding:40px;">
                        <MudProgressCircular Indeterminate="true" Style="color:#E65100;" />
                    </div>
                }
                else if (_appeals?.Any() == true)
                {
                    @foreach (var a in _appeals)
                    {
                        <div style="background:#FFFFFF; border:1px solid #EDE7F6;
                                                            border-radius:14px; padding:16px 18px; margin-bottom:12px;
                                                            box-shadow:0 2px 8px rgba(106,27,154,0.06);">
                            <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
                                <div style="flex:1;">
                                    <MudText Style="font-size:13px; font-weight:600; color:#1A237E;">
                                        @a.type
                                    </MudText>
                                    <MudText Style="font-size:11px; color:#90A4AE;">
                                        @a.student_no  ·  @a.date.ToString("MMM dd, yyyy")
                                    </MudText>
                                </div>
                                <span style="@SeverityBadge(a.severity)">@a.severity</span>
                            </div>

                            @if (!string.IsNullOrEmpty(a.appeal_text))
                            {
                                <div style="background:#FFF3E0; border:1px solid #FFE0B2;
                                                                            border-radius:8px; padding:10px 12px; margin-bottom:10px;">
                                    <MudText Style="font-size:10px; color:#E65100; font-weight:600;
                                                                                   text-transform:uppercase; margin-bottom:4px;">
                                        Appeal Reason
                                    </MudText>
                                    <MudText Style="font-size:12px; color:#795548;">@a.appeal_text</MudText>
                                </div>
                            }

                            <div style="display:flex; gap:8px;">
                                <MudButton Variant="Variant.Filled"
                                           Size="Size.Small"
                                           OnClick="() => OpenAppealReview(a.id, a.type)"
                                           Style="background:#6A1B9A; color:#FFFFFF; text-transform:none; flex:1; font-size:11px;">
                                    Review Appeal
                                </MudButton>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="background:#FFFFFF; border:1px solid #EDE7F6;
                                                border-radius:16px; padding:48px; text-align:center;
                                                box-shadow:0 2px 8px rgba(106,27,154,0.06);">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline"
                                 Style="color:#CE93D8; font-size:48px;" />
                        <MudText Style="color:#90A4AE; font-size:13px; margin-top:8px; display:block;">
                            No pending appeals at this time.
                        </MudText>
                    </div>
                }
            }

            @* ══════════ STUDENT REPORT OVERLAY ══════════ *@
            @if (_reportStudent != null)
            {
                <div style="position:fixed; inset:0; background:rgba(0,0,0,0.5);
                                    z-index:500; overflow-y:auto; padding:16px;">
                    <div style="background:#FFFFFF; border-radius:20px; padding:20px;
                                        max-width:480px; margin:0 auto;
                                        box-shadow:0 20px 60px rgba(0,0,0,0.2);">

                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
                            <MudText Typo="Typo.h6" Style="font-weight:700; color:#1A237E;">
                                Student Report
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           OnClick="CloseReport"
                                           Size="Size.Small" />
                        </div>

                        @* Student Info *@
                        <div style="background:linear-gradient(135deg,#EDE7F6,#D1C4E9);
                                            border-radius:12px; padding:14px; margin-bottom:14px;">
                            <MudText Style="font-weight:700; color:#1A237E; font-size:15px;">
                                @_reportStudent.name
                            </MudText>
                            <MudText Style="font-size:12px; color:#546E7A;">
                                @_reportStudent.student_no  ·  @_reportStudent.course  @_reportStudent.year
                            </MudText>
                            <MudText Style="font-size:12px; color:#546E7A; margin-top:2px;">
                                Status: <strong style="color:@GetAccountStatusColor(_reportStudent.status);">
                                    @_reportStudent.status
                                </strong>
                            </MudText>
                        </div>

                        @* Stats *@
                        <div style="display:flex; gap:8px; margin-bottom:14px;">
                            <div style="flex:1; background:#F3E5F5; border-radius:10px;
                                                padding:10px; text-align:center;">
                                <MudText Style="font-size:1.4rem; font-weight:700; color:#6A1B9A;">
                                    @_reportStudent.violation_count
                                </MudText>
                                <MudText Style="font-size:10px; color:#90A4AE;">Violations</MudText>
                            </div>
                            <div style="flex:2; background:#F3E5F5; border-radius:10px; padding:10px;">
                                <MudText Style="font-size:10px; color:#90A4AE; margin-bottom:2px;">
                                    Recommended Action
                                </MudText>
                                <MudText Style="font-size:12px; font-weight:600; color:#1A237E;">
                                    @_reportStudent.recommended_action
                                </MudText>
                            </div>
                        </div>

                        @* Violations *@
                        @if (_reportStudent.violations?.Any() == true)
                        {
                            <MudText Style="font-size:11px; font-weight:700; color:#6A1B9A;
                                                           text-transform:uppercase; margin-bottom:8px;">
                                Violation History
                            </MudText>
                            @foreach (var v in _reportStudent.violations)
                            {
                                <div style="padding:10px 0; border-bottom:1px solid #F3E5F5;">
                                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:2px;">
                                        <MudText Style="font-size:12px; font-weight:600; color:#1A237E; flex:1;">
                                            @v.type
                                        </MudText>
                                        <span style="@SeverityBadge(v.severity)">@v.severity</span>
                                        <span style="@StatusBadge(v.status)">@v.status</span>
                                    </div>
                                    <MudText Style="font-size:11px; color:#90A4AE;">
                                        @v.date.ToString("MMM dd, yyyy")  ·  @v.recorded_by
                                    </MudText>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

        </div>
    </MudMainContent>

    @* ── Bottom Nav ── *@
    <div style="position:fixed; bottom:0; left:0; right:0; z-index:300;
                background:rgba(255,255,255,0.97); backdrop-filter:blur(24px);
                border-top:1px solid #EDE7F6;
                box-shadow:0 -4px 20px rgba(106,27,154,0.08);
                height:68px; display:flex; align-items:center; padding:0 8px;">

        <button @onclick="() => SwitchTab(0)" style="@NavBtn(0)">
            <MudIcon Icon="@Icons.Material.Filled.People" Style="@NavIcon(0)" />
            <span style="@NavLabel(0)">Students</span>
        </button>
        <button @onclick="() => SwitchTab(1)" style="@NavBtn(1)">
            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Style="@NavIcon(1)" />
            <span style="@NavLabel(1)">Violations</span>
        </button>
        <button @onclick="() => SwitchTab(2)" style="@NavBtn(2)">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Style="@NavIcon(2)" />
            <span style="@NavLabel(2)">Appeals</span>
        </button>

    </div>

</MudLayout>

@* ══════════ APPEAL REVIEW DIALOG ══════════ *@
@if (_showAppealDialog)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.5);
                        z-index:1000; display:flex; align-items:center; justify-content:center; padding:16px;">
        <div style="background:#FFFFFF; border-radius:20px; padding:24px;
                            width:100%; max-width:420px;
                            box-shadow:0 20px 60px rgba(0,0,0,0.20);">

            <MudText Typo="Typo.h6" Style="font-weight:700; color:#1A237E; margin-bottom:4px;">
                Review Appeal
            </MudText>
            <MudText Style="font-size:12px; color:#546E7A; margin-bottom:16px;">
                Violation: <strong>@_reviewingViolationType</strong>
            </MudText>

            <MudSelect @bind-Value="_appealReviewStatus"
                       Label="Decision *"
                       Variant="Variant.Outlined"
                       Style="margin-bottom:14px;">
                <MudSelectItem Value="@("Approved")">Approve Appeal</MudSelectItem>
                <MudSelectItem Value="@("Rejected")">Reject Appeal</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="_appealRemarks"
                          Label="Remarks"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Placeholder="Add your remarks here..."
                          Style="margin-bottom:16px;" />

            <div style="display:flex; gap:10px;">
                <MudButton Variant="Variant.Outlined"
                           FullWidth="true"
                           OnClick="CloseAppealDialog"
                           Style="border-color:#90A4AE; color:#546E7A; text-transform:none;">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           FullWidth="true"
                           Disabled="_isReviewing"
                           OnClick="SubmitAppealReview"
                           Style="background:#6A1B9A; color:#FFFFFF; text-transform:none;">
                    @(_isReviewing ? "Submitting…" : "Submit")
                </MudButton>
            </div>
        </div>
    </div>
}
@* ══════════ LOGOUT CONFIRM DIALOG ══════════ *@
@if (_showLogoutDialog)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.5);
                    z-index:1000; display:flex; align-items:center; justify-content:center;
                    padding:16px;">
        <div style="background:#FFFFFF; border-radius:20px; padding:24px;
                        width:100%; max-width:360px;
                        box-shadow:0 20px 60px rgba(0,0,0,0.20);">

            <div style="display:flex; flex-direction:column; align-items:center;
                            text-align:center; margin-bottom:20px;">
                <div style="width:52px; height:52px; border-radius:50%;
                                background:linear-gradient(135deg,#E1F5FE,#B3E5FC);
                                border:1px solid #81D4FA;
                                display:flex; align-items:center; justify-content:center;
                                margin-bottom:12px;
                                box-shadow:0 4px 8px rgba(2,136,209,0.15);">
                    <MudIcon Icon="@Icons.Material.Filled.Logout"
                             Style="color:#0288D1; font-size:26px;" />
                </div>
                <MudText Typo="Typo.h6"
                         Style="font-weight:700; color:#1A237E; margin-bottom:4px;">
                    Log Out?
                </MudText>
                <MudText Style="font-size:12px; color:#546E7A;">
                    Are you sure you want to log out of your account?
                </MudText>
            </div>

            <div style="display:flex; gap:10px;">
                <MudButton Variant="Variant.Outlined"
                           FullWidth="true"
                           OnClick="CloseLogoutDialog"
                           Style="border-color:#90A4AE; color:#546E7A;
                                      text-transform:none; border-radius:10px;">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           FullWidth="true"
                           OnClick="ConfirmLogout"
                           Style="background:#0288D1; color:#FFFFFF;
                                      text-transform:none; font-weight:600;
                                      border-radius:10px;
                                      box-shadow:0 4px 8px rgba(2,136,209,0.25);">
                    Log Out
                </MudButton>
            </div>

        </div>
    </div>
}

@code {
    private int _activeTab = 0;

    // Students
    private List<GuidanceStudentItem>? _students;
    private bool _isLoadingStudents = false;
    private string _studentSearch = string.Empty;
    private GuidanceStudentReport? _reportStudent;

    // Violations
    private List<ViolationsByStatusGroup>? _violationsByStatus;
    private bool _isLoadingViolations = false;

    // Appeals
    private List<GuidanceAppealItem>? _appeals;
    private bool _isLoadingAppeals = false;

    // Appeal review dialog
    private bool _showAppealDialog = false;
    private int _reviewingViolationId;
    private string _reviewingViolationType = string.Empty;
    private string _appealReviewStatus = "Approved";
    private string _appealRemarks = string.Empty;
    private bool _isReviewing = false;

    private bool _showLogoutDialog = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadStudentsAsync();
    }

    private async Task SwitchTab(int idx)
    {
        _activeTab = idx;
        if (idx == 1 && _violationsByStatus == null) await LoadViolationsAsync();
        if (idx == 2 && _appeals == null) await LoadAppealsAsync();
    }

    private async Task LoadStudentsAsync()
    {
        _isLoadingStudents = true;
        var result = await GuidanceService.GetAllStudentsAsync();
        if (result.Status == 200)
            _students = result.Data;
        else
            Snackbar.Add(result.Message ?? "Failed to load students.", Severity.Error);
        _isLoadingStudents = false;
    }

    private async Task LoadViolationsAsync()
    {
        _isLoadingViolations = true;
        var result = await GuidanceService.GetViolationsByStatusAsync();
        if (result.Status == 200)
            _violationsByStatus = result.Data;
        else
            Snackbar.Add(result.Message ?? "Failed to load violations.", Severity.Warning);
        _isLoadingViolations = false;
    }

    private async Task LoadAppealsAsync()
    {
        _isLoadingAppeals = true;
        var result = await GuidanceService.GetPendingAppealsAsync();
        if (result.Status == 200)
            _appeals = result.Data;
        else
            _appeals = new List<GuidanceAppealItem>(); // no appeals is OK
        _isLoadingAppeals = false;
    }

    private async Task ViewStudentReport(string studentNo)
    {
        var result = await GuidanceService.GetStudentReportAsync(studentNo);
        if (result.Status == 200)
            _reportStudent = result.Data;
        else
            Snackbar.Add(result.Message ?? "Failed to load report.", Severity.Error);
    }

    private void CloseReport() => _reportStudent = null;

    private async Task WarnStudent(string studentNo)
    {
        var result = await GuidanceService.WarnStudentAsync(studentNo);
        if (result.Status == 200)
        {
            Snackbar.Add("Student has been warned.", Severity.Success);
            await LoadStudentsAsync();
        }
        else
            Snackbar.Add(result.Message ?? "Failed to warn student.", Severity.Error);
    }

    private async Task RecommendDismissal(string studentNo)
    {
        var result = await GuidanceService.RecommendDismissalAsync(studentNo);
        if (result.Status == 200)
        {
            Snackbar.Add("Student recommended for dismissal.", Severity.Success);
            await LoadStudentsAsync();
        }
        else
            Snackbar.Add(result.Message ?? "Failed to recommend dismissal.", Severity.Error);
    }

    private void OpenAppealReview(int id, string violationType)
    {
        _reviewingViolationId = id;
        _reviewingViolationType = violationType;
        _appealReviewStatus = "Approved";
        _appealRemarks = string.Empty;
        _showAppealDialog = true;
    }

    private void CloseAppealDialog() => _showAppealDialog = false;

    private async Task SubmitAppealReview()
    {
        if (string.IsNullOrWhiteSpace(_appealReviewStatus)) return;
        _isReviewing = true;
        var result = await GuidanceService.ReviewAppealAsync(
            _reviewingViolationId,
            new AppealReviewRequest { AppealStatus = _appealReviewStatus, AppealRemarks = _appealRemarks });
        _isReviewing = false;

        if (result.Status == 200)
        {
            Snackbar.Add($"Appeal {_appealReviewStatus.ToLower()}.", Severity.Success);
            CloseAppealDialog();
            _appeals = null;
            await LoadAppealsAsync();
        }
        else
            Snackbar.Add(result.Message ?? "Failed to review appeal.", Severity.Error);
    }
    private void Logout() => _showLogoutDialog = true;

    private void CloseLogoutDialog() => _showLogoutDialog = false;

    private async Task ConfirmLogout()
    {
        _showLogoutDialog = false;
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }

