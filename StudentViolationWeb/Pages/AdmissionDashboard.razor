    @@media (max-width:1100px) { .overview-grid,.clearance-grid { grid-template-columns:1fr; } .enrollment-grid { grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr); } .page-content { padding:22px 20px 34px; } }
    @@media (max-width:760px) {
        .admissions-sidebar { position:fixed; inset:auto 0 0; width:auto; height:66px; flex-direction:row; align-items:center; padding:5px 8px; border-top:1px solid #34445d; }
        .brand-lockup,.workspace-label,.sidebar-spacer,.sidebar-user { display:none; }
        .admissions-nav { width:100%; flex-direction:row; justify-content:space-around; gap:3px; }
        .admissions-nav button { min-height:52px; flex:1; flex-direction:column; justify-content:center; gap:2px; padding:3px 2px; font-size:.59rem; }
        .admissions-nav button.active { box-shadow:inset 0 2px #91aaff; }
