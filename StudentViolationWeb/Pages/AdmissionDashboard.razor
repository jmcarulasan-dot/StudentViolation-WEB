</style>

@code {
    private string _section = "overview";
    private bool _drawerOpen = true;
    private bool _busy;
    private string? _pageError;
    private List<AdmissionEnrollment>? _enrollments;
    private List<AdmissionRegistrationRequest>? _requests;
    private string _enrollmentSearch = "";
    private string _clearanceStudentNo = "";
    private AdmissionClearanceResponse? _clearance;
    private AdmissionEnrollmentForm _form = new();
    private readonly Dictionary<string, string> _enrollmentErrors = new(StringComparer.OrdinalIgnoreCase);
    private List<string> CourseOptions => (_enrollments ?? new List<AdmissionEnrollment>()).Select(x => x.Course?.Trim()).Where(x => !string.IsNullOrWhiteSpace(x)).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private List<string> YearOptions => (_enrollments ?? new List<AdmissionEnrollment>()).Select(x => x.Year?.Trim()).Where(x => !string.IsNullOrWhiteSpace(x)).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();

    private int PendingCount => _requests?.Count(x => x.RequestStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase)) ?? 0;
    private string SectionTitle => _section switch { "requests" => "Registration requests", "enrollments" => "Enrollment records", "clearance" => "Student clearance", _ => "Admissions overview" };
    private string SectionSubtitle => _section switch { "requests" => "Review student account requests and verify registrations.", "enrollments" => "Maintain student enrollment records.", "clearance" => "Check a student’s eligibility and record clearance.", _ => "Manage student registration, enrollment, and clearance in one place." };

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        _pageError = null;
        var requestsTask = AdmissionService.GetRegistrationRequestsAsync();
        var enrollmentsTask = AdmissionService.GetEnrollmentsAsync();
        await Task.WhenAll(requestsTask, enrollmentsTask);
        var requests = await requestsTask;
        var enrollments = await enrollmentsTask;
        _requests = requests.Data ?? new();
        _enrollments = enrollments.Data ?? new();
        if (requests.Status >= 400) _pageError = requests.Message;
        else if (enrollments.Status >= 400) _pageError = enrollments.Message;
    }

    private async Task SelectSection(string section)
    {
        _section = section;
        if (_section == "requests") _requests = null;
        if (_section == "enrollments") _enrollments = null;
        if (_section == "overview" || _section == "requests" || _section == "enrollments") await LoadAll();
        _drawerOpen = false;
    }

    private async Task RefreshCurrent() => await LoadAll();
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private static string Initials(string first, string last) => $"{(first.Length > 0 ? first[0] : '?')}{(last.Length > 0 ? last[0] : '?')}";
    private static bool IsPending(string? status) => status?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true;
    private static Color RequestColor(string? status) => status?.Equals("Approved", StringComparison.OrdinalIgnoreCase) == true ? Color.Success : status?.Equals("Rejected", StringComparison.OrdinalIgnoreCase) == true ? Color.Error : Color.Warning;

    private async Task ReviewRequest(int id, bool approve)
    {
        _busy = true;
        var result = approve ? await AdmissionService.ApproveRegistrationAsync(id) : await AdmissionService.RejectRegistrationAsync(id);
        _busy = false;
        Snackbar.Add(result.Message ?? (approve ? "Request approved." : "Request rejected."), result.Status is >= 200 and < 300 ? Severity.Success : Severity.Error);
        if (result.Status is >= 200 and < 300) await LoadAll();
    }

    private bool HasEnrollmentError(string field) => _enrollmentErrors.ContainsKey(field);
    private string? EnrollmentError(string field) => _enrollmentErrors.TryGetValue(field, out var message) ? message : null;
    private void ClearEnrollmentError(string field) => _enrollmentErrors.Remove(field);

    private void OnCourseChanged(string? value)
    {
        _form.Course = value ?? "";
        ClearEnrollmentError(nameof(_form.Course));
    }

    private void OnYearChanged(string? value)
    {
        _form.Year = value ?? "";
        ClearEnrollmentError(nameof(_form.Year));
    }

    private bool ValidateEnrollment()
    {
        _enrollmentErrors.Clear();

        if (string.IsNullOrWhiteSpace(_form.StudentNo))
            _enrollmentErrors[nameof(_form.StudentNo)] = "Student number is required.";
        else if (!Regex.IsMatch(_form.StudentNo.Trim(), @"^[A-Za-z0-9]{3}-\d{2}-\d{4}-[A-Za-z0-9]{6}$"))
            _enrollmentErrors[nameof(_form.StudentNo)] = "Use the format ABC-00-0000-ABC123.";

        if (string.IsNullOrWhiteSpace(_form.FirstName))
            _enrollmentErrors[nameof(_form.FirstName)] = "First name is required.";
        if (string.IsNullOrWhiteSpace(_form.LastName))
            _enrollmentErrors[nameof(_form.LastName)] = "Last name is required.";

        if (string.IsNullOrWhiteSpace(_form.Email))
            _enrollmentErrors[nameof(_form.Email)] = "Email address is required.";
        else if (!Regex.IsMatch(_form.Email.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
            _enrollmentErrors[nameof(_form.Email)] = "Enter a valid email address, such as name@example.com.";

        if (CourseOptions.Count == 0)
            _enrollmentErrors[nameof(_form.Course)] = "No course options were returned from the enrollment database.";
        else if (!CourseOptions.Contains(_form.Course, StringComparer.OrdinalIgnoreCase))
            _enrollmentErrors[nameof(_form.Course)] = "Select a course from the list.";
        if (YearOptions.Count == 0)
            _enrollmentErrors[nameof(_form.Year)] = "No year options were returned from the enrollment database.";
        else if (!YearOptions.Contains(_form.Year, StringComparer.OrdinalIgnoreCase))
            _enrollmentErrors[nameof(_form.Year)] = "Select a year level from the list.";

        return _enrollmentErrors.Count == 0;
    }

    private async Task CreateEnrollment()
    {
        if (!ValidateEnrollment())
        {
            Snackbar.Add("Please correct the highlighted fields.", Severity.Warning);
            return;
        }

        _busy = true;
        var result = await AdmissionService.CreateEnrollmentAsync(_form);
        _busy = false;
        Snackbar.Add(result.Message ?? (result.Status == 200 ? "Enrollment saved." : "Unable to save enrollment."), result.Status == 200 ? Severity.Success : Severity.Error);
        if (result.Status == 200)
        {
            _form = new();
            _enrollmentErrors.Clear();
            await LoadAll();
        }
    }

    private async Task CheckClearance()
    {
        if (string.IsNullOrWhiteSpace(_clearanceStudentNo)) { Snackbar.Add("Enter a student number.", Severity.Warning); return; }
        _busy = true;
        _clearance = await AdmissionService.CheckClearanceAsync(_clearanceStudentNo.Trim());
        _busy = false;
        if (_clearance.Status >= 400) Snackbar.Add(_clearance.Message ?? "Could not check clearance.", Severity.Error);
    }

    private async Task SignClearance()
    {
        if (_clearance is null || !_clearance.CanSign) return;
        _busy = true;
        var result = await AdmissionService.SignClearanceAsync(_clearanceStudentNo.Trim());
        _busy = false;
        Snackbar.Add(result.Message ?? "Clearance signature submitted.", result.Status == 200 ? Severity.Success : Severity.Error);
        if (result.Status == 200) await CheckClearance();
    }

    private void Logout() => Nav.NavigateTo("/login");
}