    .clearance-form { display:flex; align-items:flex-start; gap:10px; max-width:720px; }
    .clearance-form .mud-input-control { flex:1; }
    .clearance-result { display:flex; flex-direction:column; align-items:flex-start; gap:10px; margin-top:8px; }
    .clearance-result .mud-alert { width:100%; }
    .clearance-message { margin:0; color:var(--muted); font-size:.78rem; }
    .process-panel { background:#f9fafc; }
    .process-icon { width:38px; height:38px; display:grid; place-items:center; border-radius:10px; color:#25815b; background:#eaf5ef; }
    .process-panel h2 { margin:12px 0 4px; font-size:.93rem; font-weight:780; }
    .process-panel > p { margin:0 0 13px; color:var(--muted); font-size:.73rem; line-height:1.55; }
    .process-step { display:flex; align-items:flex-start; gap:9px; padding:9px 0; border-top:1px solid var(--line); }
    .process-step > span { width:21px; height:21px; display:grid; flex:none; place-items:center; border-radius:50%; color:#536b9c; background:#e9edf5; font-size:.65rem; font-weight:800; }
    .process-step div { display:flex; flex-direction:column; gap:3px; }
