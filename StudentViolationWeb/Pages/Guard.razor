@page "/guard/"
@inject NavigationManager Nav
@inject AuthService AuthService
@inject GuardService GuardService
@inject ISnackbar Snackbar

<PageTitle>Guard Dashboard</PageTitle>

<MudLayout>

    @* bar *@
    <MudAppBar Elevation="0"
               Style="background:rgba(255,255,255,0.95);
                      backdrop-filter:blur(20px);
                      border-bottom:1px solid #E1F5FE;">


        <MudSpacer />

        <MudText Typo="Typo.h6"
                 Style="font-weight:700; color:#0288D1; letter-spacing:0.02em;">
            Guard Dashboard
        </MudText>

        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       OnClick="Logout"
                       Style="color:#546E7A;" />
    </MudAppBar>

    @* main *@
    <MudMainContent Style="background:#F4F9FD; min-height:100vh; padding-bottom:80px;">

        <div style="position:fixed; inset:0;
                    background:
                        radial-gradient(ellipse 60% 50% at 0% 0%,  #E1F5FE 0%, transparent 60%),
                        radial-gradient(ellipse 40% 40% at 100% 100%, #B3E5FC 0%, transparent 60%);
                    pointer-events:none; z-index:0;"></div>
        <div style="position:fixed; inset:0;
                    background-image:radial-gradient(#B3E5FC 1px, transparent 1px);
                    background-size:24px 24px;
                    pointer-events:none; z-index:0; opacity:0.45;"></div>

        <div style="position:relative; z-index:1; padding:16px 16px 0;">

            @* ══════════ TAB 0 — VALIDATE ══════════ *@
            @if (_activeTab == 0)
            {
                <div style="background:linear-gradient(135deg,#FFFFFF,#E1F5FE);
                                        border:1px solid #B3E5FC; border-radius:16px;
                                        padding:16px 20px; margin-bottom:18px;
                                        display:flex; align-items:center; gap:16px;
                                        box-shadow:0 4px 12px rgba(2,136,209,0.08);">
                    <div style="width:44px; height:44px; border-radius:12px;
                                            display:flex; align-items:center; justify-content:center;
                                            flex-shrink:0;">
                        <img src="Image/aclc_logo(1).png"
                             alt="ACLC Logo"
                             style="width: 30px; height: auto;" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle1"
                                 Style="font-weight:700; color:#0288D1; font-size:14px;">
                            Validate Student
                        </MudText>
                        <MudText Typo="Typo.caption"
                                 Style="color:#546E7A; font-size:11px;">
                            Enter student number to check their violation status
                        </MudText>
                    </div>
                </div>

                @* Search Box *@
                <div style="background:#FFFFFF; border:1px solid #B3E5FC; border-radius:14px;
                                        padding:16px; margin-bottom:14px;
                                        box-shadow:0 2px 8px rgba(2,136,209,0.06);">
                    <MudTextField @bind-Value="_studentNoInput"
                                  Label="Student Number"
                                  Variant="Variant.Outlined"
                                  Placeholder="e.g. C26-01-0001-MAN121"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="ValidateStudent"
                                  Style="margin-bottom:12px;"
                                  @onkeyup="OnSearchKeyUp" />
                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Disabled="_isValidating"
                               OnClick="ValidateStudent"
                               Style="background:#0288D1; color:#FFFFFF; text-transform:none; border-radius:10px; height:44px;">
                        @(_isValidating ? "Validating…" : "Validate Student")
                    </MudButton>
                </div>

                @* Result Card *@
                @if (_studentData != null)
                {
                    <div style="background:#FFFFFF; border:1px solid @GetWarningBorderColor(_studentData.warning_level);
                                                        border-radius:16px; padding:18px; margin-bottom:14px;
                                                            box-shadow:0 4px 12px rgba(2,136,209,0.08);">

                        @* Student Info *@
                        <div style="display:flex; align-items:center; gap:14px; margin-bottom:14px;">
                            <div style="width:48px; height:48px; border-radius:50%;
                                                                    background:#0288D1;
                                                                display:flex; align-items:center; justify-content:center;
                                                                font-size:18px; font-weight:700; color:#FFFFFF;
                                                                flex-shrink:0;">
                                @(_studentData.name?.Substring(0, 1).ToUpper() ?? "S")
                            </div>
                            <div style="flex:1;">
                                <MudText Style="font-weight:700; color:#1A237E; font-size:15px;">
                                    @_studentData.name
                                </MudText>
                                <MudText Style="color:#546E7A; font-size:12px;">
                                    @_studentData.student_no  ·  @_studentData.course  @_studentData.year
                                </MudText>
                            </div>
                            <div style="background:@GetWarningBg(_studentData.warning_level);
                                                                border:1px solid @GetWarningBorderColor(_studentData.warning_level);
                                                                border-radius:20px; padding:4px 12px;">
                                <MudText Style="@($"font-size:11px; font-weight:700; color:{GetWarningColor(_studentData.warning_level)};")">
                                    ⚠ @_studentData.warning_level?.ToUpper()
                                </MudText>
                            </div>
                        </div>

                        @* Violation Count *@
                        <div style="background:#F9FBE7; border:1px solid #F0F4C3;
                                                            border-radius:10px; padding:10px 14px; margin-bottom:14px;
                                                            display:flex; align-items:center; gap:10px;">
                            <MudIcon Icon="@Icons.Material.Filled.Report" Style="color:#F9A825; font-size:20px;" />
                            <MudText Style="font-size:13px; color:#795548; font-weight:600;">
                                Total Violations: <strong>@_studentData.violation_count</strong>
                            </MudText>
                        </div>

                        @* Violation History *@
                        @if (_studentData.violations?.Any() == true)
                        {
                            <MudText Style="font-size:12px; font-weight:700; color:#546E7A;
                                                                               text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">
                                Violation History
                            </MudText>
                            @foreach (var v in _studentData.violations)
                            {
                                <div style="padding:10px 0; border-bottom:1px solid #F0F7FF;
                                                                                            display:flex; align-items:flex-start; gap:10px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Circle"
                                             Style="@($"color:{GetSeverityColor(v.severity)}; font-size:10px; margin-top:4px;")" />
                                    <div style="flex:1;">
                                        <MudText Style="font-size:12px; font-weight:600; color:#1A237E;">
                                            @v.type
                                        </MudText>
                                        <MudText Style="font-size:11px; color:#90A4AE;">
                                            @v.date.ToString("MMM dd, yyyy")  ·  @v.severity  ·  @v.status
                                        </MudText>
                                        @if (!string.IsNullOrEmpty(v.details))
                                        {
                                            <MudText Style="font-size:11px; color:#607D8B; margin-top:2px;">
                                                @v.details
                                            </MudText>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="text-align:center; padding:12px;">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                         Style="color:#4FC3F7; font-size:32px;" />
                                <MudText Style="font-size:12px; color:#90A4AE; margin-top:4px; display:block;">
                                    No violations on record
                                </MudText>
                            </div>
                        }
                    </div>
                }
            }


            @* ══════════ TAB 1 — RECORD VIOLATION ══════════ *@
            @if (_activeTab == 1)
            {
                <div style="background:linear-gradient(135deg,#FFFFFF,#E8F5E9);
                                            border:1px solid #C8E6C9; border-radius:16px;
                                            padding:16px 20px; margin-bottom:18px;
                                            display:flex; align-items:center; gap:16px;
                                            box-shadow:0 4px 12px rgba(46,125,50,0.08);">
                    <div style="width:44px; height:44px; border-radius:12px;
                                                background:#C62828;
                                                display:flex; align-items:center; justify-content:center;
                                                flex-shrink:0; box-shadow:0 4px 8px rgba(198,40,40,0.25);">
                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Style="color:#FFFFFF; font-size:22px;" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#C62828; font-size:14px;">
                            Record Violation
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#546E7A; font-size:11px;">
                            Log a new violation for a student
                        </MudText>
                    </div>
                </div>
                <div style="background:#FFFFFF; border:1px solid #C8E6C9; border-radius:14px;
                                            padding:18px; box-shadow:0 2px 8px rgba(2,136,209,0.06);">

                    <MudTextField @bind-Value="_violationForm.StudentNo"
                                  Label="Student Number *"
                                  Variant="Variant.Outlined"
                                  Placeholder="e.g. C26-01-0001-MAN121"
                                  Style="margin-bottom:14px;" />

                    <MudTextField @bind-Value="_violationForm.ViolationType"
                                  Label="Violation Type *"
                                  Variant="Variant.Outlined"
                                  Placeholder="e.g. No ID, No Uniform, Smoking"
                                  Style="margin-bottom:14px;" />

                    <MudTextField @bind-Value="_violationForm.Details"
                                  Label="Details *"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Placeholder="Describe the violation in detail..."
                                  Style="margin-bottom:14px;" />

                    <MudSelect @bind-Value="_violationForm.Severity"
                               Label="Severity *"
                               Variant="Variant.Outlined"
                               Style="margin-bottom:18px;">
                        <MudSelectItem Value="@("minor")">Minor</MudSelectItem>
                        <MudSelectItem Value="@("moderate")">Moderate</MudSelectItem>
                        <MudSelectItem Value="@("major")">Major</MudSelectItem>
                        <MudSelectItem Value="@("critical")">Critical</MudSelectItem>
                    </MudSelect>

                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Disabled="_isRecording"
                               OnClick="RecordViolation"
                               Style="background:#C62828; color:#FFFFFF; text-transform:none; border-radius:10px; height:48px; font-weight:700;">
                        @(_isRecording ? "Recording…" : "Record Violation")
                    </MudButton>
                </div>

                @* Result after recording *@
                @if (_recordResult != null)
                {
                    <div style="background:#E1F5FE; border:1px solid #81D4FA;
                                                        border-radius:12px; padding:14px 18px; margin-top:14px;">
                        <MudText Style="font-weight:700; color:#0288D1; font-size:13px; margin-bottom:4px;">
                            ✅ Violation Recorded
                        </MudText>
                        <MudText Style="font-size:12px; color:#546E7A;">
                            @_recordResult.name (@_recordResult.student_no)
                        </MudText>
                        <MudText Style="font-size:12px; color:#546E7A;">
                            New count: <strong>@_recordResult.new_violation_count</strong>
                            · Level: <strong style="color:@GetWarningColor(_recordResult.new_warning_level);">
                                @_recordResult.new_warning_level?.ToUpper()
                            </strong>
                        </MudText>
                    </div>
                }
            }

            @* ══════════ TAB 2 — SUMMARY ══════════ *@
            @if (_activeTab == 2)
            {
                <div style="background:linear-gradient(135deg,#FFFFFF,#E8F5E9);
                                            border:1px solid #C8E6C9; border-radius:16px;
                                            padding:16px 20px; margin-bottom:18px;
                                            display:flex; align-items:center; gap:16px;
                                            box-shadow:0 4px 12px rgba(46,125,50,0.08);">
                    <div style="width:44px; height:44px; border-radius:12px;
                                                background:#1565C0;
                                                display:flex; align-items:center; justify-content:center;
                                                flex-shrink:0;">
                        <MudIcon Icon="@Icons.Material.Filled.Analytics" Style="color:#FFFFFF; font-size:22px;" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1565C0; font-size:14px;">
                            Violation Summary
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#546E7A; font-size:11px;">
                            Summary report by date range
                        </MudText>
                    </div>
                </div>
                <div style="background:#FFFFFF; border:1px solid #B3E5FC; border-radius:14px;
                                        padding:16px; margin-bottom:14px;
                                            box-shadow:0 2px 8px rgba(2,136,209,0.06);">
                    <MudDatePicker @bind-Date="_summaryStart"
                                   Label="Start Date"
                                   Variant="Variant.Outlined"
                                   Style="margin-bottom:12px;" />
                    <MudDatePicker @bind-Date="_summaryEnd"
                                   Label="End Date"
                                   Variant="Variant.Outlined"
                                   Style="margin-bottom:14px;" />
                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Disabled="_isLoadingSummary"
                               OnClick="LoadSummary"
                               Style="background:#1565C0; color:#FFFFFF; text-transform:none; border-radius:10px; height:44px;">
                        @(_isLoadingSummary ? "Loading…" : "Get Summary")
                    </MudButton>
                </div>

                @if (_summary != null)
                {
                    <div style="display:flex; gap:10px; margin-bottom:14px;">
                        <div style="flex:1; background:#FFFFFF; border:1px solid #B3E5FC;
                                                            border-radius:12px; padding:14px 10px; text-align:center;
                                                                    box-shadow:0 2px 6px rgba(2,136,209,0.06);">
                            <MudText Style="font-size:1.6rem; font-weight:700; color:#1565C0;">
                                @_summary.totalViolations
                            </MudText>
                            <MudText Style="font-size:10px; color:#90A4AE; font-weight:600;
                                                                   text-transform:uppercase; letter-spacing:0.04em;">
                                Total
                            </MudText>
                        </div>
                        <div style="flex:2; background:#FFFFFF; border:1px solid #B3E5FC;
                                                            border-radius:12px; padding:14px;
                                                                    box-shadow:0 2px 6px rgba(2,136,209,0.06);">
                            <MudText Style="font-size:10px; color:#90A4AE; font-weight:600;
                                                                   text-transform:uppercase; letter-spacing:0.04em; margin-bottom:4px;">
                                Top Violation
                            </MudText>
                            <MudText Style="font-size:13px; font-weight:700; color:#1A237E;">
                                @(_summary.topViolation ?? "N/A")
                            </MudText>
                        </div>
                    </div>
                }
            }

            @* ══════════ TAB 3 — STUDENTS ══════════ *@
            @if (_activeTab == 3)
            {
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
                    <div style="width:4px; height:20px; background:#0288D1; border-radius:4px;"></div>
                    <MudIcon Icon="@Icons.Material.Filled.People" Style="color:#0288D1; font-size:19px;" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:#1A237E; font-size:15px;">
                        All Students
                    </MudText>
                    <MudSpacer />
                    <MudText Style="font-size:11px; color:#90A4AE;">@(_students?.Count ?? 0) students</MudText>
                </div>

                <MudTextField @bind-Value="_studentSearch"
                              Placeholder="Search by name or student no..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Style="margin-bottom:12px; background:#FFFFFF; border-radius:12px;" />

                @if (_isLoadingStudents)
                {
                    <div style="text-align:center; padding:40px;">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else
                {
                    <div style="background:#FFFFFF; border:1px solid #B3E5FC;
                                                        border-radius:16px; overflow:hidden;
                                                                box-shadow:0 2px 10px rgba(2,136,209,0.06);">
                        @{
                            var filtered = _students?
                            .Where(s =>
                            string.IsNullOrEmpty(_studentSearch) ||
                            (s.name?.Contains(_studentSearch, StringComparison.OrdinalIgnoreCase) == true) ||
                            (s.student_no?.Contains(_studentSearch, StringComparison.OrdinalIgnoreCase) == true))
                            .ToList();
                        }

                        @if (filtered?.Any() == true)
                        {
                            @foreach (var s in filtered)
                            {
                                <div style="padding:12px 18px; border-bottom:1px solid #F0F7FF;
                                                                                            display:flex; align-items:center; gap:12px;">
                                    <div style="width:36px; height:36px; border-radius:50%;
                                                                                                                background:linear-gradient(135deg,#B3E5FC,#81D4FA);
                                                                                                                border:1px solid #4FC3F7;
                                                                                                display:flex; align-items:center; justify-content:center;
                                                                                                                font-size:14px; font-weight:700; color:#0288D1;
                                                                                                flex-shrink:0;">
                                        @(s.name?.Substring(0, 1).ToUpper() ?? "S")
                                    </div>
                                    <div style="flex:1; min-width:0;">
                                        <MudText Style="font-size:13px; font-weight:600; color:#1A237E;
                                                                                                       white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                            @s.name
                                        </MudText>
                                        <MudText Style="font-size:11px; color:#90A4AE;">
                                            @s.student_no  ·  @s.course  @s.year
                                        </MudText>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="padding:40px; text-align:center;">
                                <MudText Style="color:#90A4AE; font-size:13px;">No students found.</MudText>
                            </div>
                        }
                    </div>
                }
            }

            @* ══════════ LOGOUT CONFIRM DIALOG ══════════ *@
            @if (_showLogoutDialog)
            {
                <div style="position:fixed; inset:0; background:rgba(0,0,0,0.5);
                        z-index:1000; display:flex; align-items:center; justify-content:center;
                        padding:16px;">
                    <div style="background:#FFFFFF; border-radius:20px; padding:24px;
                            width:100%; max-width:360px;
                            box-shadow:0 20px 60px rgba(0,0,0,0.20);">

                        <div style="display:flex; flex-direction:column; align-items:center;
                                text-align:center; margin-bottom:20px;">
                            <div style="width:52px; height:52px; border-radius:50%;
                                    background:linear-gradient(135deg,#E1F5FE,#B3E5FC);
                                    border:1px solid #81D4FA;
                                    display:flex; align-items:center; justify-content:center;
                                    margin-bottom:12px;
                                    box-shadow:0 4px 8px rgba(2,136,209,0.15);">
                                <MudIcon Icon="@Icons.Material.Filled.Logout"
                                         Style="color:#0288D1; font-size:26px;" />
                            </div>
                            <MudText Typo="Typo.h6"
                                     Style="font-weight:700; color:#1A237E; margin-bottom:4px;">
                                Log Out?
                            </MudText>
                            <MudText Style="font-size:12px; color:#546E7A;">
                                Are you sure you want to log out of your account?
                            </MudText>
                        </div>

                        <div style="display:flex; gap:10px;">
                            <MudButton Variant="Variant.Outlined"
                                       FullWidth="true"
                                       OnClick="CloseLogoutDialog"
                                       Style="border-color:#90A4AE; color:#546E7A;
                                          text-transform:none; border-radius:10px;">
                                Cancel
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       FullWidth="true"
                                       OnClick="ConfirmLogout"
                                       Style="background:#0288D1; color:#FFFFFF;
                                          text-transform:none; font-weight:600;
                                          border-radius:10px;
                                          box-shadow:0 4px 8px rgba(2,136,209,0.25);">
                                Log Out
                            </MudButton>
                        </div>

                    </div>
                </div>
            }
        </div>
    </MudMainContent>

    @* ── Bottom Nav ── *@
    <div style="position:fixed; bottom:0; left:0; right:0; z-index:300;
                background:rgba(255,255,255,0.97); backdrop-filter:blur(24px);
                border-top:1px solid #E1F5FE;
                box-shadow:0 -4px 20px rgba(2,136,209,0.08);
                height:68px; display:flex; align-items:center; padding:0 8px;">

        <button @onclick="() => SetTab(0)" style="@NavBtn(0)">
            <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Style="@NavIcon(0)" />
            <span style="@NavLabel(0)">Validate</span>
        </button>
        <button @onclick="() => SetTab(1)" style="@NavBtn(1)">
            <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Style="@NavIcon(1)" />
            <span style="@NavLabel(1)">Record</span>
        </button>
        <button @onclick="() => SetTab(2)" style="@NavBtn(2)">
            <MudIcon Icon="@Icons.Material.Filled.Analytics" Style="@NavIcon(2)" />
            <span style="@NavLabel(2)">Summary</span>
        </button>
        <button @onclick="() => SetTab(3)" style="@NavBtn(3)">
            <MudIcon Icon="@Icons.Material.Filled.People" Style="@NavIcon(3)" />
            <span style="@NavLabel(3)">Students</span>
        </button>

    </div>

</MudLayout>

@code {
    private int _activeTab = 0;

    // Tab 0 — Validate
    private string _studentNoInput = string.Empty;
    private bool _isValidating = false;
    private GuardStudentData? _studentData;

    // Tab 1 — Record
    private RecordViolationRequest _violationForm = new();
    private bool _isRecording = false;
    private RecordViolationData? _recordResult;

    // Tab 2 — Summary
    private DateTime? _summaryStart = DateTime.Today.AddDays(-30);
    private DateTime? _summaryEnd = DateTime.Today;
    private bool _isLoadingSummary = false;
    private GuardSummaryData? _summary;

    // Tab 3 — Students
    private List<GuardStudentListItem>? _students;
    private bool _isLoadingStudents = false;
    private string _studentSearch = string.Empty;

    private bool _showLogoutDialog = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadStudentsAsync();
    }

    private async Task LoadStudentsAsync()
    {
        _isLoadingStudents = true;
        var result = await GuardService.GetAllStudentsAsync();
        if (result.Status == 200)
            _students = result.Data;
        _isLoadingStudents = false;
    }

    private async Task SetTab(int idx)
    {
        _activeTab = idx;
        if (idx == 3 && (_students == null || _students.Count == 0))
            await LoadStudentsAsync();
    }

    private async Task ValidateStudent()
    {
        if (string.IsNullOrWhiteSpace(_studentNoInput))
        {
            Snackbar.Add("Please enter a student number.", Severity.Warning);
            return;
        }
        _isValidating = true;
        _studentData = null;
        var result = await GuardService.ValidateStudentAsync(_studentNoInput.Trim().ToUpper());
        if (result.Status == 200)
            _studentData = result.Data;
        else
            Snackbar.Add(result.Message ?? "Student not found.", Severity.Error);
        _isValidating = false;
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ValidateStudent();
    }

    private async Task RecordViolation()
    {
        if (string.IsNullOrWhiteSpace(_violationForm.StudentNo) ||
            string.IsNullOrWhiteSpace(_violationForm.ViolationType) ||
            string.IsNullOrWhiteSpace(_violationForm.Details) ||
            string.IsNullOrWhiteSpace(_violationForm.Severity))
        {
            Snackbar.Add("All fields are required.", Severity.Warning);
            return;
        }
        _isRecording = true;
        _recordResult = null;
        var result = await GuardService.RecordViolationAsync(_violationForm);
        if (result.Status == 200)
        {
            _recordResult = result.Data;
            Snackbar.Add("Violation recorded successfully!", Severity.Success);
            _violationForm = new RecordViolationRequest();
        }
        else
        {
            Snackbar.Add(result.Message ?? "Failed to record violation.", Severity.Error);
        }
        _isRecording = false;
    }

    private async Task LoadSummary()
    {
        if (_summaryStart == null || _summaryEnd == null)
        {
            Snackbar.Add("Please select both start and end dates.", Severity.Warning);
            return;
        }
        _isLoadingSummary = true;
        _summary = null;
        var result = await GuardService.GetSummaryAsync(_summaryStart.Value, _summaryEnd.Value);
        if (result.Status == 200)
            _summary = result.Data;
        else
            Snackbar.Add(result.Message ?? "No violations found in this range.", Severity.Warning);
        _isLoadingSummary = false;
    }

    private void Logout() => _showLogoutDialog = true;

    private void CloseLogoutDialog() => _showLogoutDialog = false;

    private async Task ConfirmLogout()
    {
        _showLogoutDialog = false;
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }

