    // ── Warning Level helpers ────────────────────────────────────────────────
    private string GetWarningColor(string? level) => level switch
    {
        "yellow" => "#F9A825",
        "orange" => "#E65100",
        "red" => "#E53935",
        _ => "#0288D1"
    };
    private string GetWarningBorderColor(string? level) => level switch
    {
        "yellow" => "#FFE082",
        "orange" => "#FFCC80",
        "red" => "#FFCDD2",
        _ => "#81D4FA"
    };
    private string GetWarningBg(string? level) => level switch
    {
        "yellow" => "#FFF8E1",
        "orange" => "#FBE9E7",
        "red" => "#FFEBEE",
        _ => "#E1F5FE"
    };
    private string GetSeverityColor(string? s) => s?.ToLower() switch
    {
        "critical" => "#E53935",
        "major" => "#F9A825",
        "moderate" => "#0288D1",
        _ => "#607D8B"
    };
